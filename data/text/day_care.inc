@ Same as Hoenn's day-care text, used by the Four Island Day-Care. Unused text translated in Emerald

DayCare_Text_ImDaycareManSpeakToMyWife::
    .string "Je suis le MONSIEUR de la PENSION.\p"
    .string "Je m'occupe des précieux POKéMON\n"
    .string "des DRESSEURS.\p"
    .string "Si tu veux que j'élève tes POKéMON,\n"
    .string "parle à ma femme.$"

DayCare_Text_DoYouWantEgg::
    .string "Ah, c'est toi!\p"
    .string "On élevait tes POKéMON et, ma\n"
    .string "parole, quelle surprise!\p"
    .string "Ton POKéMON avait un OEUF!\p"
    .string "On ne sait pas d'où il vient, mais\n"
    .string "ton POKéMON l'avait.\p"
    .string "Tu le veux, n'est-ce pas?$"

DayCare_Text_YourMonIsDoingFine::
    .string "Ah, c'est toi! Content de te voir.\n"
    .string "Ton {STR_VAR_1} va bien.$"

DayCare_Text_IllKeepIt::
    .string "Bon, alors je le garde.\n"
    .string "Merci!$"

DayCare_Text_YouHaveNoRoomForIt::
    .string "Tu n'as pas de place…\n"
    .string "Reviens quand tu en auras fait.$"

DayCare_Text_ReceivedEgg::
    .string "{PLAYER} reçoit l'OEUF du\n"
    .string "MONSIEUR de la PENSION.$"

DayCare_Text_TakeGoodCareOfIt::
    .string "Prends-en bien soin.$"

DayCare_Text_SeeWifeIfYouWantToPickUpMon::
	.string "ポケモンを　ひきとりたい　ときは\n"
	.string "ばさんに　いって　おくれ$"

DayCare_Text_YourMonsAreDoingFine::
    .string "Ah, c'est toi! Ton {STR_VAR_1} et\n"
    .string "{STR_VAR_2} vont bien.$"

DayCare_Text_IWillKeepDoYouWantIt::
    .string "Je vais vraiment le garder.\n"
    .string "Tu le veux, n'est-ce pas?$"

DayCare_Text_WouldYouLikeUsToRaiseMon::
    .string "Je suis la DAME de la PENSION.\p"
    .string "Nous pouvons élever des POKéMON\n"
    .string "pour toi.\p"
    .string "Veux-tu qu'on en élève un?$"

DayCare_Text_WhichMonShouldWeRaise::
    .string "Quel POKéMON veux-tu nous confier?$"

DayCare_Text_WellRaiseYourMon::
    .string "Bien, nous allons élever ton\n"
    .string "{STR_VAR_1} un moment.\p"
    .string "Reviens le chercher plus tard.$"

DayCare_Text_WeCanRaiseOneMore::
    .string "Nous pouvons élever deux de tes\n"
    .string "POKéMON.\p"
    .string "Veux-tu qu'on en élève un autre?$"

DayCare_Text_HusbandWasLookingForYou::
    .string "Mon mari te cherchait.$"

DayCare_Text_FineThenComeAgain::
    .string "Oh, bon, d'accord.\n"
    .string "Reviens nous voir.$"

DayCare_Text_NotEnoughMoney::
    .string "Tu n'as pas assez d'argent…$"

DayCare_Text_TakeOtherOneBackToo::
    .string "Reprends-tu aussi l'autre?$"

DayCare_Text_ComeAgain::
    .string "Très bien.\n"
    .string "Reviens nous voir.$"

DayCare_Text_GoodToSeeYou::
    .string "Ah, c'est toi!\n"
    .string "Contente de te voir.\p"
    .string "Tes POKéMON ne peuvent que bien\n"
    .string "se porter!$"

DayCare_Text_YourMonHasGrownXLevels::
    .string "Ton {STR_VAR_1} a gagné\n"
    .string "{STR_VAR_2} niveaux.$"

DayCare_Text_YourPartyIsFull::
    .string "Ton équipe de POKéMON est pleine.\n"
    .string "Fais de la place, puis reviens.$"

DayCare_Text_TakeBackWhichMon::
	.string "どっちの　ポケモンを　ひきとるかい？$"

DayCare_Text_ItWillCostX::
    .string "Pour récupérer ton {STR_VAR_1},\n"
    .string "ça te coûtera ¥{STR_VAR_2}.$"

DayCare_Text_HeresYourMon::
    .string "Parfait!\n"
    .string "Voici ton POKéMON.$"

DayCare_Text_TookBackMon::
    .string "{PLAYER} récupère {STR_VAR_1}\n"
    .string "auprès de la DAME de la PENSION.$"

DayCare_Text_YouHaveJustOneMon::
    .string "Oh? Mais tu n'as qu'un seul\n"
    .string "POKéMON.\p"
    .string "Reviens une autre fois.$"

DayCare_Text_TakeYourMonBack::
    .string "Veux-tu reprendre ton POKéMON?$"

DayCare_Text_WhatWillYouBattleWith::
    .string "Si tu me laisses ce POKéMON, avec\n"
    .string "quoi vas-tu combattre?\p"
    .string "Reviens une autre fois.$"

DayCare_Text_Huh::
    .string "Hein?$"
