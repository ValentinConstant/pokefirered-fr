Help_Text_HowToUsePokedex::
    .string "{CIRCLE_1} Choisis “POKéDEX” dans le MENU.\n"
    .string "{CIRCLE_2} Choisis un POKéMON avec les\n"
    .string "   commandes “LISTE POKéMON,”\n"
    .string "   “HABITATS DES POKéMON,” et\n"
    .string "   “RECHERCHE.”\n"
    .string "{CIRCLE_3} Choisis un POKéMON pour voir\n"
    .string "   ses infos détaillées.$"

Help_Text_HowToUsePokemon::
    .string "{CIRCLE_1} Choisis “POKéMON” dans le MENU.\n"
    .string "{CIRCLE_2} Choisis un POKéMON de l'équipe.\n"
    .string "{CIRCLE_3} Choisis “RÉSUMÉ,” “ORDRE,”\n"
    .string "   ou “OBJET.”$"

Help_Text_HowToUseSummary::
    .string "{CIRCLE_1} Choisis “RÉSUMÉ.”\n"
    .string "{CIRCLE_2} Appuie à gauche ou à droite sur\n"
    .string "   la Croix {PLUS} pour voir les infos:\n"
    .string "   “INFOS POKéMON”\n"
    .string "   “STATS POKéMON”\n"
    .string "   “CAPACITÉS”$"

Help_Text_HowToUseSwitch::
    .string "{CIRCLE_1} Choisis le POKéMON à\n"
    .string "   déplacer.\n"
    .string "{CIRCLE_2} Choisis “ORDRE.”\n"
    .string "{CIRCLE_3} Choisis le POKéMON à échanger\n"
    .string "   avec le premier.\n"
    .string "Le POKéMON en haut de l'équipe sera\n"
    .string "le premier envoyé au combat.$"

Help_Text_HowToUseItem::
    .string "{CIRCLE_1} Choisis “OBJET.”\n"
    .string "{CIRCLE_2} Choisis de “DONNER” un objet\n"
    .string "   à tenir au POKéMON,\n"
    .string "   ou de “PRENDRE” l'objet qu'il tient.\n"
    .string "Un POKéMON ne peut tenir qu'un seul\n"
    .string "objet!$"

Help_Text_HowToUseBag::
    .string "{CIRCLE_1} Choisis “SAC” dans le MENU.\n"
    .string "{CIRCLE_2} Appuie à gauche ou à droite sur\n"
    .string "   la Croix {PLUS} pour voir les poches:\n"
    .string "   “OBJETS”\n"
    .string "   “OBJETS RARES”\n"
    .string "   “POKé BALLS”\n"
    .string "   Haut ou bas pour choisir un objet.$"

Help_Text_HowToUseAnItem::
    .string "{CIRCLE_1} Choisis la poche “OBJETS.”\n"
    .string "{CIRCLE_2} Appuie en haut ou en bas sur la\n"
    .string "   Croix {PLUS} pour choisir un objet.\n"
    .string "{CIRCLE_3} Choisis “UTILISER” pour utiliser\n"
    .string "   l'objet choisi.\n"
    .string "Certains objets ne peuvent pas servir\n"
    .string "selon le lieu ou la situation.$"

Help_Text_HowToUseKeyItem::
    .string "{CIRCLE_1} Choisis la poche “OBJETS RARES.”\n"
    .string "{CIRCLE_2} Appuie en haut ou en bas sur la\n"
    .string "   Croix {PLUS} pour choisir un objet.\n"
    .string "{CIRCLE_3} Choisis “UTILISER” pour utiliser\n"
    .string "   l'objet rare choisi.$"

Help_Text_HowToUsePokeBall::
    .string "{CIRCLE_1} Face à un POKéMON sauvage,\n"
    .string "   choisis la poche “POKé BALLS”\n"
    .string "   du SAC.\n"
    .string "{CIRCLE_2} Appuie en haut ou en bas sur la\n"
    .string "   Croix {PLUS} pour choisir une BALL.\n"
    .string "{CIRCLE_3} Choisis “UTILISER” pour lancer\n"
    .string "   la POKé BALL choisie.$"

Help_Text_HowToUsePlayer::
    .string "{CIRCLE_1} Choisis “{PLAYER}” dans le MENU.\n"
    .string "{CIRCLE_2} Ta CARTE DRESSEUR s'affiche,\n"
    .string "   recto avec les infos de base.\n"
    .string "   Appuie sur A pour la retourner.\n"
    .string "{CIRCLE_3} De nombreuses données sont au\n"
    .string "   verso de la CARTE.$"

Help_Text_HowToUseSave::
    .string "{CIRCLE_1} Choisis “SAUVER” dans le MENU.\n"
    .string "{CIRCLE_2} Choisis “OUI” et ta progression\n"
    .string "   est enregistrée.\n"
    .string "Une fois la partie sauvegardée, tu\n"
    .string "peux éteindre la console. Tu pourras\n"
    .string "reprendre là où tu as sauvegardé.$"

Help_Text_HowToUseOption::
    .string "{CIRCLE_1} Choisis “OPTIONS” dans le MENU.\n"
    .string "{CIRCLE_2} Appuie en haut ou en bas sur la\n"
    .string "   Croix {PLUS} pour choisir une option,\n"
    .string "   puis à gauche ou à droite pour\n"
    .string "   la régler.\n"
    .string "{CIRCLE_3} Choisis “ANNULER” ou appuie\n"
    .string "   sur B après tes réglages.$"

Help_Text_HowToUsePotion::
    .string "{CIRCLE_1} Ouvre le MENU.\n"
    .string "{CIRCLE_2} Appuie en haut ou en bas sur la\n"
    .string "   Croix {PLUS} et choisis “SAC.”\n"
    .string "{CIRCLE_3} Choisis “POTION” dans la poche\n"
    .string "   “OBJETS.”\n"
    .string "{CIRCLE_4} Choisis “UTILISER.”\n"
    .string "{CIRCLE_5} Choisis le POKéMON à soigner.$"

Help_Text_HowToUseTownMap::
    .string "{CIRCLE_1} Ouvre le MENU.\n"
    .string "{CIRCLE_2} Appuie en haut ou en bas sur la\n"
    .string "   Croix {PLUS} et choisis “SAC.”\n"
    .string "{CIRCLE_3} Gauche ou droite pour ouvrir la\n"
    .string "   poche “OBJETS RARES”, puis haut\n"
    .string "   ou bas pour choisir “CARTE.” \n"
    .string "{CIRCLE_4} Choisis “UTILISER” pour l'ouvrir.$"

Help_Text_HowToUseTM::
    .string "{CIRCLE_1} Ouvre le MENU.\n"
    .string "{CIRCLE_2} Ouvre la poche “OBJETS RARES”\n"
    .string "   du “SAC.”\n"
    .string "{CIRCLE_3} “OUVRE” la BOÎTE CT.\n"
    .string "{CIRCLE_4} Choisis et “UTILISE” une CT.\n"
    .string "{CIRCLE_5} Choisis un POKéMON qui peut\n"
    .string "   apprendre la capacité de la CT.$"

Help_Text_HowToUseHM::
    .string "{CIRCLE_1} Ouvre le MENU.\n"
    .string "{CIRCLE_2} Ouvre la poche “OBJETS RARES”\n"
    .string "   du “SAC.”\n"
    .string "{CIRCLE_3} “OUVRE” la BOÎTE CT.\n"
    .string "{CIRCLE_4} Choisis et “UTILISE” une CS.\n"
    .string "{CIRCLE_5} Choisis un POKéMON qui peut\n"
    .string "   l'apprendre.\n"
    .string "Les CS s'oublient mal, attention!$"

Help_Text_HowToUseMoveOutsideOfBattle::
    .string "{CIRCLE_1} Ouvre le MENU.\n"
    .string "{CIRCLE_2} Choisis “POKéMON.”\n"
    .string "{CIRCLE_3} Choisis un POKéMON qui connaît\n"
    .string "   une CS. Les CS utilisables\n"
    .string "   s'affichent en bleu. Choisis-en\n"
    .string "   une pour détruire un obstacle,\n"
    .string "   voler, surfer, etc.$"

Help_Text_HowToRideBicycle::
    .string "{CIRCLE_1} Ouvre le MENU. Ouvre la poche\n"
    .string "   “OBJETS RARES” du “SAC”\n"
    .string "   et choisis la “BICYCLETTE.”\n"
    .string "{CIRCLE_2} Choisis “UTILISER” pour rouler.\n"
    .string "   Tu peux aussi l'“ENREGISTRER”\n"
    .string "   pour l'utiliser d'une pression\n"
    .string "   sur SELECT.$"

Help_Text_HowToEnterName::
    .string "{CIRCLE_1} Place le curseur sur la lettre\n"
    .string "   voulue avec la Croix {PLUS}, puis\n"
    .string "   appuie sur A pour la saisir.\n"
    .string "{CIRCLE_2} Appuie sur B pour effacer.\n"
    .string "{CIRCLE_3} Appuie sur SELECT pour passer\n"
    .string "   des majuscules aux minuscules.\n"
    .string "{CIRCLE_4} Appuie sur A sur “OK.”$"

Help_Text_HowToUsePC::
    .string "{CIRCLE_1} Va dans un CENTRE POKéMON,\n"
    .string "   approche du PC et appuie sur A.$"

Help_Text_HowToUseBillsPC::
    .string "{CIRCLE_1} Choisis “PC de {STR_VAR_1}”.\n"
    .string "{CIRCLE_2} Choisis une des trois premières\n"
    .string "   options pour accéder au Système\n"
    .string "   de Stockage POKéMON.\n"
    .string "Si tu attrapes un POKéMON avec six\n"
    .string "POKéMON dans l'équipe, il est envoyé\n"
    .string "automatiquement dans une BOÎTE!$"

Help_Text_HowToUseWithdraw::
    .string "{CIRCLE_1} Choisis un POKéMON de la BOÎTE\n"
    .string "   avec la Croix {PLUS}.\n"
    .string "{CIRCLE_2} Choisis “RETIRER” pour le sortir\n"
    .string "   de la BOÎTE et l'ajouter à ton\n"
    .string "   équipe.\n"
    .string "Impossible de retirer un POKéMON si\n"
    .string "tu en as déjà six avec toi!$"

Help_Text_HowToUseDeposit::
    .string "{CIRCLE_1} Choisis un POKéMON de ton équipe\n"
    .string "   avec la Croix {PLUS}.\n"
    .string "{CIRCLE_2} Choisis “DÉPOSER.”\n"
    .string "{CIRCLE_3} Choisis la BOÎTE, puis appuie\n"
    .string "   sur A pour stocker le POKéMON.\n"
    .string "Si tu n'as qu'un seul POKéMON sur\n"
    .string "toi, il ne peut pas être stocké!$"

Help_Text_HowToUseMove::
    .string "{CIRCLE_1} Choisis un POKéMON de la BOÎTE.\n"
    .string "{CIRCLE_2} Prends-le avec “DÉPLACER” et\n"
    .string "   bouge-le où tu veux avec la\n"
    .string "   Croix {PLUS}.\n"
    .string "{CIRCLE_3} Amène-le sur le nom de la BOÎTE\n"
    .string "   et appuie à gauche ou à droite\n"
    .string "   pour le mettre dans une autre BOÎTE.$"

Help_Text_HowToMoveItems::
    .string "{CIRCLE_1} Un POKéMON affiché en pâle peut\n"
    .string "   tenir un objet: choisis-le et\n"
    .string "   appuie sur A.\n"
    .string "{CIRCLE_2} Un POKéMON bien visible peut\n"
    .string "   donner son objet à un autre\n"
    .string "   POKéMON, ou le ranger dans le\n"
    .string "   SAC avec le Bouton A.$"

Help_Text_HowToUsePlayersPC::
    .string "{CIRCLE_1} Choisis “PC de {PLAYER}”.\n"
    .string "{CIRCLE_2} Choisis “STOCKAGE” ou\n"
    .string "   “BOÎTE LETTRES.”\n"
    .string "Tu peux stocker des objets sur ton\n"
    .string "PC si ton SAC est plein, et retirer\n"
    .string "les objets stockés sur ton PC.$"

Help_Text_HowToUseWithdrawItem::
    .string "{CIRCLE_1} Choisis “RETIRER OBJET.”\n"
    .string "{CIRCLE_2} Choisis l'objet à retirer.\n"
    .string "{CIRCLE_3} L'objet retiré est placé dans\n"
    .string "   la poche OBJETS du SAC.\n"
    .string "   Il peut aussi être donné\n"
    .string "   directement à un POKéMON.$"

Help_Text_HowToUseDepositItem::
    .string "{CIRCLE_1} Choisis “DÉPOSER OBJET.”\n"
    .string "{CIRCLE_2} Choisis l'objet du SAC à déposer\n"
    .string "   avec la Croix {PLUS}.\n"
    .string "{CIRCLE_3} S'il y en a plusieurs \n"
    .string "   à déposer, choisis la quantité\n"
    .string "   avec la Croix {PLUS},\n"
    .string "   puis appuie sur A.$"

Help_Text_HowToUseMailbox::
    .string "Une LETTRE retirée d'un POKéMON va\n"
    .string "dans la BOÎTE LETTRES. S'il n'y a pas\n"
    .string "de LETTRE, elle est inutilisable.\n"
    .string "{CIRCLE_1} Choisis “PC de {PLAYER}”.\n"
    .string "{CIRCLE_2} Choisis “BOÎTE LETTRES” pour lire\n"
    .string "   ou faire tenir une LETTRE.$"

Help_Text_HowToUseProfOaksPC::
    .string "{CIRCLE_1} Choisis “PC du PR CHEN”.\n"
    .string "{CIRCLE_2} Le PR CHEN évaluera ton\n"
    .string "   POKéDEX.\n"
    .string "Ses évaluations te donneront des\n"
    .string "indices pour attraper plus de POKéMON!$"

Help_Text_HowToOpenMenu::
    .string "{CIRCLE_1} Appuie sur START.\n"
    .string "{CIRCLE_2} Le MENU s'ouvre à droite.\n"
    .string "{CIRCLE_3} Selon la situation, le MENU\n"
    .string "   peut proposer d'autres rubriques.\n"
    .string "Le MENU ne s'ouvre pas dans certains\n"
    .string "cas: pendant une discussion, une\n"
    .string "action, un combat, etc.$"

Help_Text_HowToUseFight::
    .string "{CIRCLE_1} Choisis “ATTAQUE.”\n"
    .string "{CIRCLE_2} Choisis une des capacités,\n"
    .string "et elle sera utilisée!$"

Help_Text_HowToUsePokemon2::
    .string "{CIRCLE_1} Choisis “POKéMON.”\n"
    .string "{CIRCLE_2} Choisis le POKéMON de ton\n"
    .string "   équipe à utiliser.\n"
    .string "{CIRCLE_3} Avec deux POKéMON ou plus, tu\n"
    .string "   peux les échanger avec\n"
    .string "   “CHANGER.” Vois les données avec\n"
    .string "   “RÉSUMÉ.”$"

Help_Text_HowToUseShift::
    .string "Cette commande remplace le POKéMON\n"
    .string "au combat par un autre de l'équipe.\n"
    .string "{CIRCLE_1} Choisis le POKéMON à envoyer.\n"
    .string "{CIRCLE_2} Choisis “CHANGER.”\n"
    .string "{CIRCLE_3} Le POKéMON choisi prendra la\n"
    .string "   place de celui au combat!$"

Help_Text_HowToUseSummary2::
    .string "{CIRCLE_1} Choisis “RÉSUMÉ.”\n"
    .string "{CIRCLE_2} Appuie à gauche ou à droite sur\n"
    .string "   la Croix {PLUS} pour voir les infos:\n"
    .string "   “INFOS POKéMON”\n"
    .string "   “STATS POKéMON”\n"
    .string "   “CAPACITÉS”$"

Help_Text_HowToUseBag2::
    .string "{CIRCLE_1} Choisis “SAC.”\n"
    .string "{CIRCLE_2} Appuie à gauche ou à droite sur\n"
    .string "   la Croix {PLUS} pour voir les poches:\n"
    .string "   “OBJETS”\n"
    .string "   “OBJETS RARES”\n"
    .string "   “POKé BALLS”\n"
    .string "   Haut ou bas pour choisir un objet.$"

Help_Text_HowToReadPokedex::
    .string "{CIRCLE_1} Les POKéMON attrapés sont\n"
    .string "   marqués d'une POKé BALL dans\n"
    .string "   la liste du POKéDEX.\n"
    .string "{CIRCLE_2} Un POKéMON attrapé fournit\n"
    .string "   beaucoup de données.\n"
	.if REVISION < 1
	.string "{CIRCLE_3} Choisis “ZONE” pour voir l'habitat\n"
	.string "   du POKéMON sur la CARTE.$"
	.else
	.string "{CIRCLE_3} Choisis “SUITE” pour voir l'habitat\n"
	.string "   du POKéMON sur la CARTE.$"
	.endif

Help_Text_HowToUseHomePC::
    .string "{CIRCLE_1} Approche du PC de la maison et\n"
    .string "   appuie sur A.\n"
    .string "{CIRCLE_2} Le PC s'allume.\n"
    .string "{CIRCLE_3} Choisis “STOCKAGE” ou\n"
    .string "   “BOÎTE LETTRES.”$"

Help_Text_HowToUseItemStorage::
    .string "{CIRCLE_1} “RETIRER OBJET” pour retirer\n"
    .string "   un objet stocké sur ton PC.\n"
    .string "{CIRCLE_2} “DÉPOSER OBJET” pour mettre \n"
    .string "   un objet du SAC sur ton PC.$"

Help_Text_HowToUseWithdrawItem2::
    .string "{CIRCLE_1} Choisis “RETIRER OBJET.”\n"
    .string "{CIRCLE_2} Choisis l'objet à retirer.\n"
    .string "{CIRCLE_3} L'objet retiré est placé dans\n"
    .string "   la poche OBJETS du SAC.\n"
    .string "   Il peut aussi être donné\n"
    .string "   directement à un POKéMON.$"

Help_Text_HowToUseDepositItem2::
    .string "{CIRCLE_1} Choisis “DÉPOSER OBJET.”\n"
    .string "{CIRCLE_2} Choisis l'objet du SAC à déposer\n"
    .string "   avec la Croix {PLUS}.\n"
    .string "{CIRCLE_3} Si le SAC est vide, cette\n"
    .string "   commande est inutilisable!$"

Help_Text_HowToUseMailbox2::
    .string "Une LETTRE retirée d'un POKéMON va\n"
    .string "dans la BOÎTE LETTRES. S'il n'y a pas\n"
    .string "de LETTRE, elle est inutilisable.\n"
    .string "{CIRCLE_1} Choisis une LETTRE pour la lire\n"
    .string "   ou la faire tenir à un POKéMON.$"

Help_Text_HowToUseRun::
    .string "Impossible de “FUIR” un combat\n"
    .string "de DRESSEUR!\n"
    .string "{CIRCLE_1} Tu peux “FUIR” un POKéMON sauvage.\n"
    .string "{CIRCLE_2} Tu fuis plus facilement si ton\n"
    .string "   POKéMON au combat est rapide.$"

Help_Text_HowToRegisterKeyItem::
    .string "Tu peux “ENREGISTRER” un objet rare\n"
    .string "pour l'utiliser avec SELECT!\n"
    .string "{CIRCLE_1} Ouvre la poche “OBJETS RARES.”\n"
    .string "{CIRCLE_2} Choisis l'objet rare, puis\n"
    .string "   “ENREGISTRER.”$"

Help_Text_HowToUseBall::
    .string "{CIRCLE_1} Lance la POKé BALL spéciale\n"
    .string "   réservée au PARC SAFARI.\n"
    .string "Quand un POKéMON sauvage apparaît,\n"
    .string "lance plein de SAFARI BALLS!$"

Help_Text_HowToUseBait::
    .string "{CIRCLE_1} Lance la nourriture spéciale\n"
    .string "   réservée au PARC SAFARI.\n"
    .string "C'est de la nourriture pour POKéMON\n"
    .string "roulée en boule. Quand l'APPÂT est\n"
    .string "lancé, le POKéMON sauvage peut être\n"
    .string "attiré et ne pas fuir!$"

Help_Text_HowToUseRock::
    .string "{CIRCLE_1} Lance un caillou ramassé au\n"
    .string "   sol du PARC SAFARI.\n"
    .string "Un caillou lancé peut faire fuir le \n"
    .string "POKéMON, mais il devient plus facile\n"
    .string "à attraper!$"

Help_Text_HowToUseHallOfFame::
    .string "{CIRCLE_1} Choisis “PANTHÉON” sur le PC.\n"
    .string "{CIRCLE_2} Tu peux voir les POKéMON entrés\n"
    .string "   au PANTHÉON.$"

