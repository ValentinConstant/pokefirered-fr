RockTunnel_1F_Text_LennyIntro::
    .string "Ce tunnel est très long, petit!$"

RockTunnel_1F_Text_LennyDefeat::
    .string "Zut!\n"
    .string "Tu as gagné!$"

RockTunnel_1F_Text_LennyPostBattle::
    .string "Méfie-toi des ONIX.\n"
    .string "Ils n'apparaissent que rarement.\p"
    .string "Ceux de haut niveau peuvent te\n"
    .string "mettre la pression!$"

RockTunnel_1F_Text_OliverIntro::
    .string "Hmm.\n"
    .string "Je me suis peut-être perdu…$"

RockTunnel_1F_Text_OliverDefeat::
    .string "Doucement!\n"
    .string "Qu'est-ce que je fais?\l"
    .string "Où est la sortie?$"

RockTunnel_1F_Text_OliverPostBattle::
    .string "Ce POKéMON endormi sur la ROUTE 12\n"
    .string "m'a forcé à faire ce détour.$"

RockTunnel_1F_Text_LucasIntro::
    .string "Les étrangers comme toi doivent\n"
    .string "me respecter!$"

RockTunnel_1F_Text_LucasDefeat::
    .string "J'abandonne!$"

RockTunnel_1F_Text_LucasPostBattle::
    .string "Tu as assez de talent pour faire\n"
    .string "de la randonnée!$"

RockTunnel_1F_Text_AshtonIntro::
    .string "Combat POKéMON!\n"
    .string "Prêt, partez!$"

RockTunnel_1F_Text_AshtonDefeat::
    .string "Partie terminée!$"

RockTunnel_1F_Text_AshtonPostBattle::
    .string "Bon, j'attraperai un NOSFERAPTI en\n"
    .string "chemin!$"

RockTunnel_1F_Text_LeahIntro::
    .string "Hiii!\p"
    .string "N'essaie rien de louche dans le\n"
    .string "noir!$"

RockTunnel_1F_Text_LeahDefeat::
    .string "Il faisait trop noir…$"

RockTunnel_1F_Text_LeahPostBattle::
    .string "J'ai vu un MACHOC dans ce tunnel.$"

RockTunnel_1F_Text_DanaIntro::
    .string "Je suis venue jusqu'ici pour\n"
    .string "chercher des POKéMON sauvages.$"

RockTunnel_1F_Text_DanaDefeat::
    .string "Je n'ai plus de POKéMON!$"

RockTunnel_1F_Text_DanaPostBattle::
    .string "Tu avais l'air mignon et gentil.\n"
    .string "Qu'est-ce que je me trompais!$"

RockTunnel_1F_Text_ArianaIntro::
    .string "Tu as des POKéMON!\n"
    .string "C'est parti!$"

RockTunnel_1F_Text_ArianaDefeat::
    .string "Tu joues serré!$"

RockTunnel_1F_Text_ArianaPostBattle::
    .string "Ouf!\n"
    .string "Je suis toute en sueur.$"

RockTunnel_1F_Text_RouteSign::
    .string "ROCK TUNNEL\n"
    .string "CERULEAN CITY - LAVENDER TOWN$"

