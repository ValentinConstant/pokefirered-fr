FourIsland_Text_IslandSign::
    .string "ÎLE 4\n"
    .string "L'île chaude, bleue et glacée$"

FourIsland_Text_LoreleiHasReturned::
    .string "OLGA est revenue.\p"
    .string "La vie en ville était trop\n"
    .string "stressante, peut-être?$"

FourIsland_Text_LoreleiMetLaprasAsChild::
    .string "OLGA est repartie.\p"
    .string "Son LOKHLASS, je crois que c'est\n"
    .string "celui qu'elle a connu enfant.\p"
    .string "C'est dans la GROTTE DE GLACE\n"
    .string "qu'elle l'a attrapé, je crois.\p"
    .string "Ce POKéMON est peut-être avec\n"
    .string "elle depuis ce temps-là.$"

FourIsland_Text_RivalAlreadyGotEggBeSmellingYa::
    .string "{RIVAL}: Hé!\n"
    .string "{PLAYER}!\p"
    .string "Qu'est-ce que tu fais dans les\n"
    .string "ÎLES SEVII?\p"
    .string "Arrête de me copier, tu sais?\p"
    .string "Bref, j'ai déjà mon OEUF de\n"
    .string "POKéMON, j'en ai fini avec l'île.\p"
    .string "Hé, je parie que tu ne sais même\n"
    .string "rien des OEUFS de POKéMON.\p"
    .string "Tu ne rempliras jamais ton\n"
    .string "POKéDEX NATIONAL comme ça.\p"
    .string "Au fait, j'ai vu quelqu'un qu'on\n"
    .string "connaît tous les deux sur l'île.\p"
    .string "Va donc voir si ça t'intrigue.\p"
    .string "Moi, je n'ai pas de temps à\n"
    .string "perdre.\p"
    .string "Salut, minable!$"

FourIsland_Text_LoreleiHasLotsOfStuffedDolls::
    .string "Oh, tu m'as trouvé!\n"
    .string "Ne dis rien à OLGA.\p"
    .string "Savais-tu qu'OLGA a des tas et\n"
    .string "des tas de peluches?\p"
    .string "Chaque fois qu'elle revient sur\n"
    .string "l'ÎLE 4, sa collection grandit!$"

FourIsland_Text_MadeSlushieUsingIcefallCaveIce::
    .string "Ouh, ça caille!\p"
    .string "J'ai fait un granité avec de la\n"
    .string "glace de la GROTTE DE GLACE.\p"
    .string "C'est frais et délicieux!$"

FourIsland_Text_LoreleisHouse::
    .string "LORELEI'S HOUSE$"

