PokemonLeague_ChampionsRoom_Text_Defeat::
    .string "NON!\n"
    .string "C'est impossible!\l"
    .string "Tu m'as battu à mon meilleur!\p"
    .string "Tout ce travail pour devenir\n"
    .string "MAÎTRE de la LIGUE?\p"
    .string "Mon règne est déjà fini?\n"
    .string "C'est pas juste!$"

PokemonLeague_ChampionsRoom_Text_Victory::
    .string "はーはッ！\n"
    .string "かった！　かった！　かった！\p"
    .string "{PLAYER}に　まける　ような\n"
    .string "おれさま　では　なーい！\p"
    .string "ま！　ポケモンの\n"
    .string "てんさい　{RIVAL}さま　あいてに\l"
    .string "ここまで　よく　がんばった！\p"
    .string "ほめて　つかわす！\n"
    .string "はーッ！　はーはッはッ！$"

PokemonLeague_ChampionsRoom_Text_PostBattle::
    .string "Pourquoi?\n"
    .string "Pourquoi j'ai perdu?\p"
    .string "Je n'ai fait aucune erreur en\n"
    .string "élevant mes POKéMON…\p"
    .string "Zut! C'est toi le nouveau MAÎTRE\n"
    .string "de la LIGUE POKéMON!\p"
    .string "Même si ça m'énerve de l'avouer…$"

PokemonLeague_ChampionsRoom_Text_OakPlayer::
    .string "OAK: {PLAYER}!$"

PokemonLeague_ChampionsRoom_Text_OakCongratulations::
    .string "CHEN: Alors, tu as gagné!\n"
    .string "Toutes mes félicitations!\p"
    .string "Tu es le nouveau MAÎTRE de la\n"
    .string "LIGUE POKéMON!\p"
    .string "Tu as tant grandi depuis ton départ\n"
    .string "avec {STR_VAR_1} pour\l"
    .string "compléter le POKéDEX.\p"
    .string "{PLAYER}, tu es devenu adulte!$"

PokemonLeague_ChampionsRoom_Text_OakImDisappointedRival::
    .string "CHEN: {RIVAL}…\n"
    .string "Tu me déçois.\p"
    .string "Je suis venu en apprenant que tu\n"
    .string "avais battu le CONSEIL 4.\p"
    .string "Mais à mon arrivée, tu avais\n"
    .string "déjà perdu!\p"
    .string "{RIVAL}, comprends-tu pourquoi\n"
    .string "tu as perdu?\p"
    .string "Tu as oublié de traiter tes\n"
    .string "POKéMON avec amour et confiance.\p"
    .string "Sans ça, tu ne redeviendras\n"
    .string "jamais MAÎTRE!$"

PokemonLeague_ChampionsRoom_Text_OakPlayerComeWithMe::
    .string "CHEN: {PLAYER}.\p"
    .string "Tu comprends que ta victoire n'est\n"
    .string "pas due qu'à toi seul.\p"
    .string "Le lien qui t'unit à tes POKéMON\n"
    .string "est merveilleux.\p"
    .string "{PLAYER}!\n"
    .string "Viens avec moi!$"

