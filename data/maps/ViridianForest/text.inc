ViridianForest_Text_FriendsItchingToBattle::
    .string "Je suis venu avec des amis pour\n"
    .string "attraper des POKéMON INSECTE!\p"
    .string "Ils meurent tous d'envie de faire\n"
    .string "des combats de POKéMON!$"

ViridianForest_Text_RickIntro::
    .string "Hé! Tu as des POKéMON!\n"
    .string "Allez!\l"
    .string "Faisons-les combattre!$"

ViridianForest_Text_RickDefeat::
    .string "Non!\n"
    .string "CHENIPAN n'y arrive pas!$"

ViridianForest_Text_RickPostBattle::
    .string "Chut! Tu vas faire fuir les\n"
    .string "insectes. Une autre fois, d'accord?$"

ViridianForest_Text_DougIntro::
    .string "Yo!\n"
    .string "Tu ne peux pas fuir si tu es\l"
    .string "DRESSEUR de POKéMON!$"

ViridianForest_Text_DougDefeat::
    .string "Hein?\n"
    .string "Je n'ai plus de POKéMON!$"

ViridianForest_Text_DougPostBattle::
    .string "C'est trop nul! Je vais en attraper\n"
    .string "des plus forts!$"

ViridianForest_Text_SammyIntro::
    .string "Hé, attends!\n"
    .string "Pourquoi tant de hâte?$"

ViridianForest_Text_SammyDefeat::
    .string "J'abandonne!\n"
    .string "Tu es doué!$"

ViridianForest_Text_SammyPostBattle::
    .string "Parfois, on trouve des objets par\n"
    .string "terre.\p"
    .string "Je cherche des trucs que j'ai fait\n"
    .string "tomber. Tu peux m'aider?$"

ViridianForest_Text_AnthonyIntro::
    .string "Je suis peut-être petit, mais je\n"
    .string "n'aimerai pas que tu me ménages!$"

ViridianForest_Text_AnthonyDefeat::
    .string "Oh, zut.\n"
    .string "Rien n'a marché.$"

ViridianForest_Text_AnthonyPostBattle::
    .string "J'ai perdu un peu de mon argent\n"
    .string "de poche…$"

ViridianForest_Text_CharlieIntro::
    .string "Tu savais que les POKéMON évoluent?$"

ViridianForest_Text_CharlieDefeat::
    .string "Oh!\n"
    .string "J'ai perdu!$"

ViridianForest_Text_CharliePostBattle::
    .string "Les POKéMON INSECTE évoluent vite.\n"
    .string "C'est super amusant!$"

ViridianForest_Text_RanOutOfPokeBalls::
    .string "Je lançais des POKé BALLS pour\n"
    .string "attraper des POKéMON, et j'en ai\l"
    .string "plus.\p"
    .string "C'est pour ça qu'on n'a jamais\n"
    .string "trop de POKé BALLS.$"

ViridianForest_Text_AvoidGrassyAreasWhenWeak::
    .string "CONSEILS AUX DRESSEURS\p"
    .string "Si tes POKéMON sont faibles et que\n"
    .string "tu veux éviter les combats, évite\l"
    .string "les hautes herbes!$"

ViridianForest_Text_UseAntidoteForPoison::
    .string "Contre le poison, l'ANTIDOTE! En\n"
    .string "vente dans les BOUTIQUES POKéMON!$"

ViridianForest_Text_ContactOakViaPCToRatePokedex::
    .string "CONSEILS AUX DRESSEURS\p"
    .string "Contacte le PR CHEN via un PC pour\n"
    .string "faire évaluer ton POKéDEX!$"

ViridianForest_Text_CantCatchOwnedMons::
    .string "CONSEILS AUX DRESSEURS\p"
    .string "Tu ne peux pas attraper un POKéMON\n"
    .string "qui appartient à quelqu'un.\p"
    .string "Lance des POKé BALLS uniquement sur\n"
    .string "des POKéMON sauvages!$"

ViridianForest_Text_WeakenMonsBeforeCapture::
    .string "CONSEILS AUX DRESSEURS\p"
    .string "Affaiblis les POKéMON avant de\n"
    .string "les capturer!\p"
    .string "En pleine forme, ils peuvent fuir!$"

ViridianForest_Text_LeavingViridianForest::
    .string "LEAVING VIRIDIAN FOREST\n"
    .string "PEWTER CITY AHEAD$"

