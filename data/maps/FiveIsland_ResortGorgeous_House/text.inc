FiveIsland_ResortGorgeous_House_Text_PleaseHearMyWish::
    .string "SELPHY: Oh?\n"
    .string "Nous connaissons-nous?\p"
    .string "Oh, mais peu importe.\p"
    .string "Je m'ennuie terriblement.\n"
    .string "S'il te plaît, écoute mon voeu.$"

FiveIsland_ResortGorgeous_House_Text_WishToSeeMonPlease::
    .string "Je veux voir un POKéMON.\n"
    .string "Un adorable {STR_VAR_1}.\p"
    .string "Je veux en voir un tout de suite.\n"
    .string "Réalise mon voeu, je t'en prie.$"

FiveIsland_ResortGorgeous_House_Text_OhImTiredOfWaiting::
    .string "SELPHY: Oh, j'en ai assez.\n"
    .string "J'en ai assez de t'attendre.\p"
    .string "Je te pardonne pour cette fois,\n"
    .string "mais ne me déçois plus.$"

FiveIsland_ResortGorgeous_House_Text_MonYouCaughtForMeThankYou::
    .string "SELPHY: Oh, bonjour.\p"
    .string "Oh, mon dieu. Ce doit être le\n"
    .string "{STR_VAR_1} attrapé pour moi.\p"
    .string "Hi hi…\n"
    .string "Il te ressemble un peu.\p"
    .string "Merci infiniment.\p"
    .string "… …  … …  … …\n"
    .string "Quelque chose ne va pas?\p"
    .string "Tu peux disposer.\p"
    .string "… …  … …  … …\n"
    .string "Oh, bon. Je comprends.\p"
    .string "SÉBASTIEN!\n"
    .string "Viens ici immédiatement!$"

FiveIsland_ResortGorgeous_House_Text_ButlerYesMyLady::
    .string "Majordome: Oui, madame.$"

FiveIsland_ResortGorgeous_House_Text_SelphyGiveTokenOfAppreciation::
    .string "SELPHY: Veillez à ce que cette\n"
    .string "personne soit remerciée.$"

FiveIsland_ResortGorgeous_House_Text_ButlerIShallDoAsYouBid::
    .string "Majordome: À vos ordres,\n"
    .string "madame.$"

FiveIsland_ResortGorgeous_House_Text_ButlerPleaseAcceptThisAsHerThanks::
    .string "Majordome: Merci d'avoir fait\n"
    .string "plaisir à Dame SELPHY.\p"
    .string "Acceptez ceci de sa part…$"

FiveIsland_ResortGorgeous_House_Text_ButlerBagAppearsToBeFull::
    .string "Majordome: Votre SAC semble\n"
    .string "malheureusement plein.$"

FiveIsland_ResortGorgeous_House_Text_OhHowDisappointing::
    .string "Oh…\n"
    .string "Quelle déception.$"

FiveIsland_ResortGorgeous_House_Text_SelphyWishYouBestOfLuck::
    .string "SELPHY: Je te souhaite bonne\n"
    .string "chance.$"

FiveIsland_ResortGorgeous_House_Text_LadySelphySmileHasBrillianceOfSun::
    .string "Majordome: Le sourire de Dame\n"
    .string "SELPHY brille comme le soleil.\p"
    .string "Je vous en prie, apportez de la\n"
    .string "joie à Dame SELPHY.$"

