Route1_Text_WorkAtPokeMartTakeSample::
    .string "Salut!\n"
    .string "Je bosse à la BOUTIQUE POKéMON.\p"
    .string "C'est une chaîne pratique qui\n"
    .string "vend toutes sortes d'objets.\p"
    .string "Passe nous voir à JADIELLE.\p"
    .string "Tiens, je t'offre un échantillon.\n"
    .string "Et voilà!$"

Route1_Text_ComeSeeUsIfYouNeedPokeBalls::
    .string "Passe nous voir s'il te faut des\n"
    .string "POKé BALLS pour capturer.$"

Route1_Text_PutPotionAway::
    .string "{PLAYER} range la POTION dans\n"
    .string "la POCHE OBJETS du SAC.$"

Route1_Text_CanJumpFromLedges::
    .string "Tu vois ces rebords sur la route?\p"
    .string "Ça fait peur, mais tu peux\n"
    .string "sauter d'ici.\p"
    .string "Tu peux rentrer à BOURG PALETTE\n"
    .string "plus vite ainsi.$"

Route1_Text_RouteSign::
    .string "ROUTE 1\n"
    .string "BOURG PALETTE - JADIELLE$"
