PokemonLeague_LancesRoom_Text_Defeat::
    .string "C'est fini!\p"
    .string "Je déteste l'avouer, mais tu es un\n"
    .string "maître POKéMON!$"

PokemonLeague_LancesRoom_Text_PostBattle::
    .string "Je n'arrive pas à croire que mes\n"
    .string "dragons aient perdu, {PLAYER}.\p"
    .string "Tu es désormais le MAÎTRE de la\n"
    .string "LIGUE POKéMON!\p"
    .string "…Enfin, tu l'aurais été, mais il te\n"
    .string "reste un dernier défi.\p"
    .string "Il reste un DRESSEUR à affronter!\n"
    .string "Il s'appelle…\p"
    .string "{RIVAL}!\p"
    .string "Il a battu le CONSEIL 4 avant\n"
    .string "toi.\p"
    .string "C'est lui le vrai MAÎTRE de la\n"
    .string "LIGUE POKéMON.$"

