Route20_Text_BarryIntro::
    .string "L'eau est peu profonde ici.\n"
    .string "Il y a plein de nageurs.$"

Route20_Text_BarryDefeat::
    .string "Plouf!$"

Route20_Text_BarryPostBattle::
    .string "J'aimerais pouvoir monter mon\n"
    .string "POKéMON. Toi, tu n'es pas fatigué.$"

Route20_Text_ShirleyIntro::
    .string "Les ÎLES ECUME, c'est un coin\n"
    .string "calme. Je suis en vacances ici.$"

Route20_Text_ShirleyDefeat::
    .string "Arrête!$"

Route20_Text_ShirleyPostBattle::
    .string "Il y a une immense caverne sous\n"
    .string "cette île.$"

Route20_Text_TiffanyIntro::
    .string "J'adore flotter avec les poissons\n"
    .string "ici, parmi les vagues.$"

Route20_Text_TiffanyDefeat::
    .string "Aïe!$"

Route20_Text_TiffanyPostBattle::
    .string "Tu veux flotter avec moi?$"

Route20_Text_IreneIntro::
    .string "Tu es en vacances, toi aussi?$"

Route20_Text_IreneDefeat::
    .string "Aucune pitié!$"

Route20_Text_IrenePostBattle::
    .string "Les ÎLES ECUME ne formaient qu'une\n"
    .string "seule île, il y a très longtemps.$"

Route20_Text_DeanIntro::
    .string "Admire ma musculature!$"

Route20_Text_DeanDefeat::
    .string "Gringalet!$"

Route20_Text_DeanPostBattle::
    .string "J'aurais dû muscler mes POKéMON,\n"
    .string "pas moi!$"

Route20_Text_DarrinIntro::
    .string "Pourquoi tu montes un POKéMON?\n"
    .string "Tu ne sais pas nager?$"

Route20_Text_DarrinDefeat::
    .string "Aïe!\n"
    .string "Torpillé!$"

Route20_Text_DarrinPostBattle::
    .string "Monter un POKéMON, ça a l'air\n"
    .string "amusant!$"

Route20_Text_RogerIntro::
    .string "Je suis venu ici sur mon POKéMON\n"
    .string "oiseau.$"

Route20_Text_RogerDefeat::
    .string "Oh, non!\n"
    .string "Qu'est-ce que je vais faire?$"

Route20_Text_RogerPostBattle::
    .string "Mes oiseaux sont épuisés. Ils ne\n"
    .string "peuvent pas me ramener en VOL!$"

Route20_Text_NoraIntro::
    .string "Mon copain m'a offert de grosses\n"
    .string "perles.$"

Route20_Text_NoraDefeat::
    .string "Oh, non!\n"
    .string "Mes perles étaient dedans!$"

Route20_Text_NoraPostBattle::
    .string "Mes perles grossiront-elles dans\n"
    .string "un CRUSTABRI?$"

Route20_Text_MissyIntro::
    .string "J'ai nagé depuis CRAMOIS'ÎLE.\n"
    .string "Ce n'était pas facile, crois-moi.$"

Route20_Text_MissyDefeat::
    .string "Je suis si déçue!$"

Route20_Text_MissyPostBattle::
    .string "Des POKéMON ont envahi un manoir\n"
    .string "abandonné à CRAMOIS'ÎLE.\p"
    .string "On l'appelle le MANOIR POKéMON,\n"
    .string "maintenant.$"

Route20_Text_MelissaIntro::
    .string "À CRAMOIS'ÎLE, à l'ouest, il y a un\n"
    .string "LABO POKéMON.\p"
    .string "Mon papa y travaille.$"

Route20_Text_MelissaDefeat::
    .string "Attends!\n"
    .string "Tu es censé attendre!$"

Route20_Text_MelissaPostBattle::
    .string "CRAMOIS'ÎLE est une île volcanique.\p"
    .string "Elle serait sortie de la mer lors\n"
    .string "d'une éruption volcanique.$"

Route20_Text_SeafoamIslands::
    .string "SEAFOAM ISLANDS$"

Route20_Text_MistyTrainsHere::
    .string "On voit souvent des DRESSEURS forts\n"
    .string "et des POKéMON EAU par ici.\p"
    .string "On dit qu'ONDINE, de l'ARÈNE\n"
    .string "d'AZURIA, s'entraîne ici.$"
