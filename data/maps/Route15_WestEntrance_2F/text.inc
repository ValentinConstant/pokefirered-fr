Route15_WestEntrance_2F_Text_GiveItemIfCaughtEnough::
    .string "Salut! Tu te souviens de moi?\n"
    .string "Je suis un ASSISTANT du PR CHEN.\p"
    .string "Si ton POKéDEX a les données de\n"
    .string "{STR_VAR_1} espèces, je dois te\l"
    .string "remettre une récompense.\p"
    .string "Le PR CHEN m'a confié\n"
    .string "{STR_VAR_2} pour toi.\p"
    .string "Alors, {PLAYER}, dis-moi.\p"
    .string "As-tu les données d'au moins\n"
    .string "{STR_VAR_1} espèces de POKéMON?$"

Route15_WestEntrance_2F_Text_GreatHereYouGo::
    .string "Génial! Tu as attrapé ou possédé\n"
    .string "{STR_VAR_3} espèces de POKéMON!\p"
    .string "Félicitations!\n"
    .string "Voilà pour toi!$"

Route15_WestEntrance_2F_Text_ReceivedItemFromAide::
    .string "{PLAYER} reçoit {STR_VAR_2}\n"
    .string "de l'ASSISTANT.$"

Route15_WestEntrance_2F_Text_ExplainExpShare::
    .string "Le MULTI EXP est un objet à faire\n"
    .string "tenir à un POKéMON.\p"
    .string "Le POKéMON recevra une part des\n"
    .string "points d'EXP. sans avoir à\l"
    .string "combattre.$"

Route15_WestEntrance_2F_Text_LargeShiningBird::
    .string "Voyons ce que montrent les\n"
    .string "jumelles…\p"
    .string "Un grand oiseau brillant vole\n"
    .string "vers la mer.$"

Route15_WestEntrance_2F_Text_SmallIslandOnHorizon::
    .string "Voyons ce que montrent les\n"
    .string "jumelles…\p"
    .string "On dirait une petite île à\n"
    .string "l'horizon!$"

