PalletTown_RivalsHouse_Text_HiBrothersAtLab::
    .string "NINA: Salut, {PLAYER}!\p"
    .string "Mon frère, {RIVAL}, est au\n"
    .string "LABO de Papy.$"

PalletTown_RivalsHouse_Text_HeardYouBattledRival::
    .string "NINA: {PLAYER}, j'ai su que tu\n"
    .string "as affronté {RIVAL}.\p"
    .string "J'aurais aimé voir ça!$"

PalletTown_RivalsHouse_Text_ErrandForGrandpaThisWillHelp::
    .string "Papy t'a demandé de faire une\n"
    .string "course?\p"
    .string "Pff, c'est feignant de sa part.\n"
    .string "Tiens, ça va t'aider.$"

PalletTown_RivalsHouse_Text_ReceivedTownMapFromDaisy::
    .string "{PLAYER} reçoit une CARTE\n"
    .string "de la part de NINA.$"

PalletTown_RivalsHouse_Text_DontHaveSpaceForThis::
    .string "Tu n'as pas de place pour ça\n"
    .string "dans ton SAC.$"

PalletTown_RivalsHouse_Text_ExplainTownMap::
    .string "Utilise la CARTE pour savoir où\n"
    .string "tu es, ou pour voir le nom\l"
    .string "des lieux.$"

PalletTown_RivalsHouse_Text_PleaseGiveMonsRest::
    .string "NINA: Comme les gens, les POKéMON\n"
    .string "sont des êtres vivants.\p"
    .string "Quand ils sont fatigués,\n"
    .string "laisse-les se reposer.$"

PalletTown_RivalsHouse_Text_ItsBigMapOfKanto::
    .string "C'est une grande carte de KANTO.\n"
    .string "Ça pourrait être utile!$"

PalletTown_RivalsHouse_Text_ShelvesCrammedFullOfBooks::
    .string "Les étagères sont pleines de\n"
    .string "livres sur les POKéMON.$"

PalletTown_RivalsHouse_Text_LikeMeToGroomMon::
    .string "NINA: Salut, {PLAYER}!\n"
    .string "Ça tombe bien.\p"
    .string "J'allais prendre le thé.\n"
    .string "Tu veux te joindre à moi?\p"
    .string "Oh, mais regarde.\n"
    .string "Tes POKéMON sont un peu sales.\p"
    .string "Tu veux que j'en toilette un?$"

PalletTown_RivalsHouse_Text_DontNeedAnyGrooming::
    .string "Pas besoin de toilettage?\n"
    .string "Bon, on prendra juste le thé.$"

PalletTown_RivalsHouse_Text_GroomWhichOne::
    .string "Lequel dois-je toiletter?$"

PalletTown_RivalsHouse_Text_LookingNiceInNoTime::
    .string "NINA: Bien, je vais le rendre\n"
    .string "beau en un rien de temps.$"

PalletTown_RivalsHouse_Text_ThereYouGoAllDone::
#ifdef BUGFIX @ The localizers missed what should be a textcolor change in the localizations.
    .string "{COLOR DARK_GRAY}{STR_VAR_1} a l'air ravi…\p"
    .string "{COLOR RED}NINA: Et voilà! C'est fini.\n"
#else @ In the JP games, gender-based text used a different font instead of different colors.
    .string "{FONT_NORMAL}{STR_VAR_1} a l'air ravi…\p"
    .string "{FONT_FEMALE}NINA: Et voilà! C'est fini.\n"
#endif
    .string "Tu vois? Il est beau, non?\p"
    .string "Hihi…\n"
    .string "C'est un POKéMON si mignon.$"

PalletTown_RivalsHouse_Text_CantGroomAnEgg::
    .string "Oh, pardon. Je ne peux vraiment\n"
    .string "pas toiletter un ŒUF.$"

PalletTown_RivalsHouse_Text_MayISeeFirstMon::
    .string "NINA: Tes POKéMON t'aiment si tu\n"
    .string "les élèves avec amour.\p"
    .string "Par exemple, {PLAYER}, je peux\n"
    .string "voir ton premier POKéMON?$"

PalletTown_RivalsHouse_Text_CouldntLoveYouMore::
    .string "Il ne pourrait pas t'aimer\n"
    .string "plus qu'il ne le fait déjà.\p"
    .string "Ton POKéMON est heureux\n"
    .string "au-delà des mots.$"

PalletTown_RivalsHouse_Text_ItLooksVeryHappy::
    .string "Il a l'air très heureux.\p"
    .string "Si {RIVAL} pouvait voir ça et\n"
    .string "en tirer une leçon.$"

PalletTown_RivalsHouse_Text_ItsQuiteFriendly::
    .string "Il est plutôt ami avec toi.\n"
    .string "Continue d'être bon avec lui!$"

PalletTown_RivalsHouse_Text_ItsWarmingUpToYou::
    .string "Il s'attache à toi.\n"
    .string "La confiance grandit entre vous.$"

PalletTown_RivalsHouse_Text_NotFamiliarWithYouYet::
    .string "Il ne te connaît pas encore\n"
    .string "très bien.\p"
    .string "Les POKéMON sont tous méfiants\n"
    .string "au tout début.$"

PalletTown_RivalsHouse_Text_DontLikeWayItGlaresAtYou::
    .string "{PLAYER}, je n'aime pas la façon\n"
    .string "dont il te fixe.\p"
    .string "Tu pourrais être un peu plus\n"
    .string "gentil avec lui?$"

PalletTown_RivalsHouse_Text_WhyWouldMonHateYouSoMuch::
    .string "…Euh, ce n'est pas facile à\n"
    .string "dire, mais…\p"
    .string "Y a-t-il une raison pour que ton\n"
    .string "POKéMON te déteste autant?$"

PalletTown_RivalsHouse_Text_LovelyAndSweetClefairy::
    .string "“La jolie et douce\n"
    .string "MÉLOFÉE”$"
