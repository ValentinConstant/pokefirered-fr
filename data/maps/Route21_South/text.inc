Route21_South_Text_JackIntro::
    .string "J'ai attrapé mes POKéMON en mer.$"

Route21_South_Text_JackDefeat::
    .string "Plongeur!!\n"
    .string "À terre!!$"

Route21_South_Text_JackPostBattle::
    .string "Où as-tu attrapé tes POKéMON?$"

Route21_South_Text_JeromeIntro::
    .string "Là, je participe à un triathlon.$"

Route21_South_Text_JeromeDefeat::
    .string "Pff…\n"
    .string "Pff… Pff…$"

Route21_South_Text_JeromePostBattle::
    .string "Je suis crevé! Mais il me reste la\n"
    .string "course à vélo et le marathon!$"

Route21_South_Text_RolandIntro::
    .string "Ahh!\n"
    .string "Sens le soleil et le vent!$"

Route21_South_Text_RolandDefeat::
    .string "Aïe!\n"
    .string "J'ai perdu!$"

Route21_South_Text_RolandPostBattle::
    .string "J'ai pris un coup de soleil\n"
    .string "terrible!$"

Route21_South_Text_ClaudeIntro::
    .string "Hé, ne fais pas fuir les poissons!$"

Route21_South_Text_ClaudeDefeat::
    .string "Pardon! Je suis juste frustré de\n"
    .string "ne rien attraper.$"

Route21_South_Text_ClaudePostBattle::
    .string "Pfff, je n'ai rien attrapé.\n"
    .string "Et si cet endroit était une\l"
    .string "géante piscine?$"

Route21_South_Text_NolanIntro::
    .string "Tiens-moi compagnie jusqu'à ce que\n"
    .string "ça morde.$"

Route21_South_Text_NolanDefeat::
    .string "Ça m'a fait passer le temps.$"

Route21_South_Text_NolanPostBattle::
    .string "Oh, attends!\n"
    .string "Ça mord! Ouais!$"

Route21_North_Text_LilIntro::
    .string "LIL: Hein? Un combat?\n"
    .string "IAN, tu ne peux pas le faire seul?$"

Route21_North_Text_LilDefeat::
    .string "LIL: Oh, tu vois?\n"
    .string "On a perdu. Content?$"

Route21_North_Text_LilPostBattle::
    .string "LIL: Je suis fatiguée.\n"
    .string "On peut rentrer, maintenant?$"

Route21_North_Text_LilNotEnoughMons::
    .string "LIL: Hein? Un combat? Je n'ai pas\n"
    .string "envie de le faire seule. Amène deux\l"
    .string "POKéMON, veux-tu?$"

Route21_North_Text_IanIntro::
    .string "IAN: Ma soeur ne fait pas assez de\n"
    .string "sport, alors je l'ai fait venir.$"

Route21_North_Text_IanDefeat::
    .string "IAN: Ohhh, soeurette!\n"
    .string "Reprends-toi!$"

Route21_North_Text_IanPostBattle::
    .string "IAN: Allez, soeurette!\p"
    .string "Tu ne vas pas maigrir comme ça!$"

Route21_North_Text_IanNotEnoughMons::
    .string "IAN: On veut un combat à deux\n"
    .string "contre deux. Tu amènes deux\l"
    .string "POKéMON?$"
