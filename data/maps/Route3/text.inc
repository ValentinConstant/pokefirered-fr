    .string "Perdu! Perdu!$"

Route3_Text_CalvinPostBattle::
    .string "Je porte toujours un short, même\n"
    .string "en hiver. C'est mon principe.$"

Route3_Text_JamesIntro::
    .string "Je vais te battre avec le POKéMON\n"
