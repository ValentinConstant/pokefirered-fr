Route3_Text_JamesPostBattle::
    .string "Les POKéMON entraînés sont plus\n"
    .string "forts que les sauvages.$"

Route3_Text_RobinIntro::
    .string "Hiii!\n"
    .string "Tu m'as touchée?$"

Route3_Text_RobinDefeat::
