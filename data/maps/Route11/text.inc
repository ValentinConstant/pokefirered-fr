Route11_Text_HugoIntro::
    .string "Victoire, défaite ou match nul!$"

Route11_Text_HugoDefeat::
    .string "Aïe!\n"
    .string "Ça n'a pas tourné en ma faveur!$"

Route11_Text_HugoPostBattle::
    .string "Les POKéMON, c'est la vie!\n"
    .string "Et vivre, c'est jouer!$"

Route11_Text_JasperIntro::
    .string "La compétition!\n"
    .string "J'en veux toujours plus!$"

Route11_Text_JasperDefeat::
    .string "J'avais une chance!$"

Route11_Text_JasperPostBattle::
    .string "Pas de place pour les lâches dans\n"
    .string "le monde des POKéMON!$"

Route11_Text_EddieIntro::
    .string "Allons-y, mais pas de triche!$"

Route11_Text_EddieDefeat::
    .string "Hein?\n"
    .string "C'est pas normal!$"

Route11_Text_EddiePostBattle::
    .string "J'ai fait de mon mieux.\n"
    .string "Je n'ai aucun regret.$"

Route11_Text_BraxtonIntro::
    .string "Attention!\n"
    .string "Je pose des câbles!$"

Route11_Text_BraxtonDefeat::
    .string "C'était électrique!$"

Route11_Text_BraxtonPostBattle::
    .string "Fais passer le mot: économise\n"
    .string "l'énergie!$"

Route11_Text_DillonIntro::
    .string "Je viens de devenir DRESSEUR.\n"
    .string "Mais je crois que je peux gagner.$"

Route11_Text_DillonDefeat::
    .string "Mes POKéMON n'ont pas pu gagner…\n"
    .string "Ils n'ont pas assez grandi?$"

Route11_Text_DillonPostBattle::
    .string "Quoi encore?\n"
    .string "Laisse-moi tranquille!$"

Route11_Text_DirkIntro::
    .string "Fwahaha!\n"
    .string "Je n'ai jamais perdu!$"

Route11_Text_DirkDefeat::
    .string "Ma première défaite!$"

Route11_Text_DirkPostBattle::
    .string "Tu as eu de la chance, c'est tout.$"

Route11_Text_DarianIntro::
    .string "Je n'ai jamais gagné…$"

Route11_Text_DarianDefeat::
    .string "Je l'avais vu venir…$"

Route11_Text_DarianPostBattle::
    .string "Je n'ai pas eu de chance, comme\n"
    .string "toujours.$"

Route11_Text_YasuIntro::
    .string "Je suis le meilleur de ma classe.\n"
    .string "Je m'entraîne chaque matin.$"

Route11_Text_YasuDefeat::
    .string "Zut! Mes POKéMON doivent être plus\n"
    .string "forts!$"

Route11_Text_YasuPostBattle::
    .string "Un gros POKéMON descend parfois\n"
    .string "des montagnes.\p"
    .string "Je parie qu'il serait fort si tu\n"
    .string "l'attrapais.$"

Route11_Text_BernieIntro::
    .string "Attention aux fils électriques!$"

Route11_Text_BernieDefeat::
    .string "Ouah!\n"
    .string "Quelle étincelle!$"

Route11_Text_BerniePostBattle::
    .string "Bon, je retourne au travail.$"

Route11_Text_DaveIntro::
    .string "J'ai élevé mes POKéMON avec soin.\n"
    .string "Ils devraient être prêts!$"

Route11_Text_DaveDefeat::
    .string "Au revoir!\n"
    .string "Merci, et au revoir!$"

Route11_Text_DavePostBattle::
    .string "Tch…\n"
    .string "Je dois en trouver des plus forts!$"

