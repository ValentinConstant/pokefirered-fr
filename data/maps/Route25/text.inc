Route25_Text_JoeyIntro::
    .string "Les DRESSEURS du coin viennent\n"
    .string "s'entraîner ici.$"

Route25_Text_JoeyDefeat::
    .string "Tu te débrouilles.$"

Route25_Text_JoeyPostBattle::
    .string "Tous les POKéMON ont des\n"
    .string "faiblesses. Même les plus forts.\p"
    .string "C'est pour ça qu'il vaut mieux\n"
    .string "élever des POKéMON de types variés.$"

Route25_Text_DanIntro::
    .string "Papa m'a emmené à une super fête\n"
    .string "sur l'OCÉANE À CARMIN-SUR-MER.$"

Route25_Text_DanDefeat::
    .string "Je ne suis pas fâché!$"

Route25_Text_DanPostBattle::
    .string "Sur l'OCÉANE, j'ai vu des DRESSEURS\n"
    .string "du monde entier.$"

Route25_Text_FlintIntro::
    .string "Je suis un mec cool.\n"
    .string "J'ai une copine!$"

Route25_Text_FlintDefeat::
    .string "Oh, zut…$"

Route25_Text_FlintPostBattle::
    .string "Oh, bon.\n"
    .string "Ma copine va me remonter le moral.$"

Route25_Text_KelseyIntro::
    .string "Salut!\n"
    .string "Mon copain est cool!$"

Route25_Text_KelseyDefeat::
    .string "Je ne suis pas en grande forme…$"

Route25_Text_KelseyPostBattle::
    .string "J'aimerais que mon copain soit\n"
    .string "aussi fort que toi.$"

Route25_Text_ChadIntro::
    .string "J'avais ce pressentiment… Je savais\n"
    .string "que je devais t'affronter!$"

Route25_Text_ChadDefeat::
    .string "Je savais que j'allais perdre,\n"
    .string "aussi!$"

Route25_Text_ChadPostBattle::
    .string "Si ton POKéMON est confus,\n"
    .string "change-le.\p"
    .string "C'est une bonne tactique.$"

Route25_Text_HaleyIntro::
    .string "Mon amie a plein de POKéMON\n"
    .string "mignons. Je suis si jalouse!$"

Route25_Text_HaleyDefeat::
    .string "Je ne suis pas si jalouse!$"

Route25_Text_HaleyPostBattle::
    .string "Tu viens du MONT SÉLÉNITE?\n"
    .string "Tu me donnes un MÉLOFÉE?$"

Route25_Text_FranklinIntro::
    .string "Je descends du MONT SÉLÉNITE, mais\n"
    .string "j'ai encore de l'énergie!$"

Route25_Text_FranklinDefeat::
    .string "Tu t'es bien battu!$"

Route25_Text_FranklinPostBattle::
    .string "Zut! Un NOSFERAPTI m'a mordu dans\n"
    .string "la grotte.$"

Route25_Text_NobIntro::
    .string "Je vais voir la collection d'un\n"
    .string "POKéMANIAC au cap.$"

Route25_Text_NobDefeat::
    .string "Tu m'as eu, et bien eu, en plus!$"

Route25_Text_NobPostBattle::
    .string "Le POKéMANIAC porte bien son nom.\p"
    .string "Sa collection contient plein\n"
    .string "d'espèces rares de POKéMON.$"

Route25_Text_WayneIntro::
    .string "Tu vas voir LÉO?\n"
    .string "D'abord, on se bat!$"

Route25_Text_WayneDefeat::
    .string "Tu es quelqu'un.$"

Route25_Text_WaynePostBattle::
    .string "Le sentier en bas est un raccourci\n"
    .string "vers AZURIA.$"

Route25_Text_SeaCottageSign::
    .string "COTTAGE DE LA MER\n"
    .string "LÉO habite ici!$"

Route25_Text_MistyHighHopesAboutThisPlace::
    .string "Ce cap est un célèbre lieu de\n"
    .string "rendez-vous galants.\p"
    .string "ONDINE, la CHAMPIONNE, a de grands\n"
    .string "espoirs pour cet endroit.$"

Route25_Text_AreYouHereAlone::
    .string "Bonjour, tu es venu seul?\p"
    .string "Si on vient au cap d'AZURIA…\n"
    .string "Eh bien, c'est en couple.$"

