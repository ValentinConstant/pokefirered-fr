Route4_Text_TrippedOverGeodude::
    .string "Aïe! J'ai trébuché sur un POKéMON\n"
    .string "rocheux, un RACAILLOU!$"

Route4_Text_CrissyIntro::
    .string "Je suis venue au MONT SÉLÉNITE pour\n"
    .string "chercher des POKéMON champignons.$"

Route4_Text_CrissyDefeat::
    .string "Après tout le mal pour les\n"
    .string "attraper!$"

Route4_Text_CrissyPostBattle::
    .string "Il n'y a peut-être plus de\n"
    .string "champignons ici.\p"
    .string "Je crois que je les ai tous pris.$"

Route4_Text_MtMoonEntrance::
    .string "MONT SÉLÉNITE\n"
    .string "Entrée du tunnel$"

Route4_Text_RouteSign::
    .string "ROUTE 4\n"
    .string "MT. MOON - CERULEAN CITY$"

Text_MegaPunchTeach::
    .string "Un poing d'une férocité rugissante!\p"
    .string "Plein de puissance destructrice!\p"
    .string "Dans les moments critiques,\n"
    .string "ULTIMAPOING est l'attaque ultime!\l"
    .string "Tu es d'accord, oui?\p"
    .string "Allez!\n"
    .string "Je l'apprends à ton POKéMON!$"

Text_MegaPunchDeclined::
    .string "Tu reviendras quand tu comprendras\n"
    .string "la valeur d'ULTIMAPOING.$"

Text_MegaPunchWhichMon::
    .string "Très bien!\n"
    .string "Quel POKéMON va l'apprendre?$"

Text_MegaPunchTaught::
    .string "Nous voilà camarades sur la voie\n"
    .string "du poing!\p"
    .string "File avant que l'idiot égaré qui\n"
    .string "n'entraîne que ses coups de pied\l"
    .string "ne te voie, là-bas.$"

Text_MegaKickTeach::
    .string "Un coup de pied d'une férocité\n"
    .string "brutale!\p"
    .string "Plein de puissance destructrice!\p"
    .string "Au fond, ULTIMAWASHI est\n"
    .string "l'attaque ultime!\l"
    .string "Tu n'es pas d'accord?\p"
    .string "D'accord!\n"
    .string "Je l'apprends à ton POKéMON!$"

Text_MegaKickDeclined::
    .string "Tu reviendras en rampant quand tu\n"
    .string "comprendras la valeur\l"
    .string "d'ULTIMAWASHI.$"

Text_MegaKickWhichMon::
    .string "Très bien!\n"
    .string "Quel POKéMON veut l'apprendre?$"

Text_MegaKickTaught::
    .string "Nous voilà âmes soeurs sur la voie\n"
    .string "du coup de pied!\p"
    .string "Cours avant que l'abruti qui\n"
    .string "n'entraîne que ses coups de poing\l"
    .string "ne te voie, là-bas.$"

Route4_Text_PeopleLikeAndRespectBrock::
    .string "Oh, ouah, c'est le BADGE ROCHE!\n"
    .string "Tu l'as eu grâce à PIERRE, non?\p"
    .string "PIERRE est cool. Il n'est pas juste\n"
    .string "fort. Les gens l'aiment et le\l"
    .string "respectent.\p"
    .string "Je veux devenir CHAMPION d'ARÈNE\n"
    .string "comme lui.$"
