SaffronCity_PokemonTrainerFanClub_Text_HuhYou::
    .string "Hein?\n"
    .string "Toi…$"

SaffronCity_PokemonTrainerFanClub_Text_YourePlayerWereYourFansNow::
    .string "Serais-tu…\n"
    .string "… …\p"
    .string "C'est toi!\n"
    .string "Tu es {PLAYER}!\p"
    .string "On parlait justement de toi!\p"
    .string "On disait qu'un DRESSEUR\n"
    .string "incroyablement doué était apparu.\p"
    .string "Et c'est toi!\n"
    .string "Tu es trop cool!\p"
    .string "Alors, on a décidé de devenir ton\n"
    .string "FAN CLUB!\p"
    .string "On espère que tu continueras à te\n"
    .string "battre pour nous montrer ta classe.\p"
    .string "Comme ça, d'autres deviendront\n"
    .string "peut-être fans comme moi.$"

SaffronCity_PokemonTrainerFanClub_Text_AlwaysCheerForYou::
    .string "Je t'encouragerai toujours!\p"
    .string "Allez, {PLAYER}, allez!$"

SaffronCity_PokemonTrainerFanClub_Text_IllAlwaysBelieveInYou::
    .string "Je croirai toujours en toi,\n"
    .string "{PLAYER}.\p"
    .string "Montre aux autres de quoi tu es\n"
    .string "capable quand tu te bats vraiment.$"

SaffronCity_PokemonTrainerFanClub_Text_WasYourFanNotAnymore::
