@ All Trainer Tower text (Lobby and Roof) is interleaved here

TrainerTower_Lobby_Text_WelcomeToTrainerTower::
    .string "Bonjour!\p"
    .string "Bienvenue à la TOUR DES DRESSEURS,\n"
    .string "où se réunissent des DRESSEURS de\l"
    .string "partout!$"

TrainerTower_Lobby_Text_TrainersUpToFloorNum::
    .string "Des DRESSEURS du monde entier se\n"
    .string "réunissent ici pour combattre.\p"
    .string "Voyons…\p"
    .string "Pour l'instant, il y a des\n"
    .string "DRESSEURS jusqu'à l'étage\l"
    .string "{STR_VAR_1}.$"

TrainerTower_Lobby_Text_TrainersUpEighthFloor::
    .string "Des DRESSEURS attendent ton défi\n"
    .string "jusqu'au huitième étage.$"

TrainerTower_Lobby_Text_LikeToChallengeTrainers::
    .string "Veux-tu défier les DRESSEURS qui\n"
    .string "attendent?$"

TrainerTower_Lobby_Text_StartClockGetSetGo::
    .string "Bien, je lance le chrono, alors\n"
    .string "donne tout ce que tu as.\p"
    .string "À vos marques…\p"
    .string "Prêts…\p"
    .string "Partez!$"

TrainerTower_Lobby_Text_PleaseVisitUsAgain::
    .string "Revenez nous voir!$"

TrainerTower_Lobby_Text_TooBadComeBackTryAgain::
    .string "C'est dommage.\p"
    .string "Je pense que tu as fourni un effort\n"
    .string "énorme en combat.\p"
    .string "Reviens et réessaie!$"

TrainerTower_Lobby_Text_GiveItYourBest::
    .string "J'espère que tu donneras le\n"
    .string "meilleur de toi-même.$"

TrainerTower_Lobby_Text_MoveCounterHereWhenTrainersSwitch::
    .string "Quand les DRESSEURS changent de\n"
    .string "place, ça peut être la cohue.\p"
    .string "Pour éviter la bousculade, on a\n"
    .string "déplacé l'accueil ici.\p"
    .string "Désolé pour la gêne occasionnée.$"

TrainerTower_Roof_Text_ImOwnerBattledPerfectly::
    .string "Bonjour…\p"
    .string "Je suis le propriétaire de cette\n"
    .string "TOUR…\p"
    .string "Comme le ciel s'élève au-dessus de\n"
    .string "ce toit…\p"
    .string "La caresse des vents, ici…\p"
    .string "Tout est si parfait…\p"
    .string "Ta façon de combattre…\n"
    .string "Elle aussi était parfaite…$"

TrainerTower_Roof_Text_ThisIsForYou::
    .string "Ceci est pour toi…$"

TrainerTower_Roof_Text_DoneItInRecordTime::
    .string "Oh!\n"
    .string "Stupéfiant!\p"
    .string "C'est merveilleux d'être monté si\n"
    .string "vite jusqu'ici.\p"
    .string "En fait, tu as réalisé un temps\n"
    .string "record…\p"
    .string "Je ferai afficher ton record à\n"
    .string "l'accueil.$"

TrainerTower_Roof_Text_TookSweetTimeGettingHere::
    .string "Tu sembles avoir pris ton temps\n"
    .string "pour arriver ici…$"

TrainerTower_Roof_Text_IdLikeToSeeBetterTime::
    .string "J'aimerais te voir réaliser un\n"
    .string "meilleur temps…\p"
    .string "Je compte sur toi.\p"
    .string "D'ici là, adieu…$"

TrainerTower_Text_XMinYZSec::
    .string "{STR_VAR_1} min\n"
    .string "{STR_VAR_2},{STR_VAR_3} s$"

TrainerTower_Lobby_Text_HereAreTheResults::
    .string "せいせきひょうです$"

TrainerTower_Lobby_Text_NeedTwoMonsForDouble::
    .string "C'est un combat en deux contre\n"
    .string "deux.\p"
    .string "Tu ne peux pas combattre sans au\n"
    .string "moins deux POKéMON.$"

TrainerTower_Lobby_Text_ExplainTrainerTower::
    .string "Ici, à la TOUR DES DRESSEURS, il y\n"
    .string "a une épreuve appelée\l"
    .string "CONTRE-LA-MONTRE.\p"
    .string "On chronomètre le temps que tu\n"
    .string "mets pour aller de l'accueil\l"
    .string "jusqu'au PROPRIÉTAIRE sur le toit.\p"
    .string "Les meilleurs temps sont inscrits\n"
    .string "au Tableau des Temps.\p"
    .string "Défie tes amis pour voir qui sera\n"
    .string "le plus rapide.\p"
    .string "Battre les DRESSEURS d'ici ne\n"
    .string "rapporte ni points d'EXP. ni\l"
    .string "argent.$"

TrainerTower_Lobby_Text_ThanksForCompeting::
    .string "Merci d'avoir participé!$"

TrainerTower_Lobby_Text_WonderWhatKindsOfTrainers::
    .string "Je suis venu voir ce que je vaux.\p"
    .string "Quels DRESSEURS m'attendent, je me\n"
    .string "demande?\p"
    .string "Ça me rend nerveux!$"

TrainerTower_Lobby_Text_StairsTougherThanAnyBattle::
    .string "Ouf, ouf…\n"
    .string "Ouf…\p"
    .string "Laisse tomber les combats! Ces\n"
    .string "escaliers… Pires qu'un combat…$"

