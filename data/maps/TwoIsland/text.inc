TwoIsland_Text_IslandSign::
    .string "ÎLE 2\n"
    .string "L'île bienfaitrice des duos$"

TwoIsland_Text_JoyfulGameCornerSign::
    .string "Saute et croque!\n"
    .string "SALLE DE JEUX joyeuse$"

TwoIsland_Text_DangerFastCurrent::
    .string "DANGER! COURANT RAPIDE!\n"
    .string "Pêche et surf interdits!$"

TwoIsland_Text_WelcomeToShopMerchandiseLimited::
    .string "Oh! Bonjour, bienvenue dans ma\n"
    .string "boutique!\p"
    .string "Nous avons ouvert récemment.\p"
    .string "Notre choix est limité, mais\n"
    .string "j'espère répondre à tes besoins.$"

TwoIsland_Text_AddedMerchandiseForLostelle::
    .string "Je ne sais comment te remercier\n"
    .string "d'avoir sauvé LOSTELLE.\p"
    .string "Grâce à toi, les gens de l'ÎLE 3\n"
    .string "ont changé d'avis sur les gens\l"
    .string "de KANTO.\p"
    .string "Et moi, je viens de KANTO, vois-tu.\p"
    .string "Les gens de l'ÎLE 3 m'ont aidé à\n"
    .string "élargir mon choix.$"

TwoIsland_Text_HopeYouGiveItYourBest::
    .string "Salut! Je fais de mon mieux ici.\n"
    .string "J'espère que toi aussi, {PLAYER}.$"

TwoIsland_Text_BringingItemsFromDistantLands::
    .string "Oh, bonjour, {PLAYER}!\n"
    .string "Bienvenue!\p"
    .string "J'ai commencé à faire venir des\n"
    .string "objets de pays lointains.\p"
    .string "J'ai aussi des objets rares.\n"
    .string "Jette un oeil!$"

TwoIsland_Text_FellowMovedFromCeladonCity::
    .string "Ce type, là, il est venu de\n"
    .string "CÉLADOPOLE.\p"
    .string "Il a ouvert une boutique avec son\n"
    .string "petit frère.\p"
    .string "On se demande s'il savait dans quoi\n"
    .string "il s'embarquait.$"

TwoIsland_Text_ShopkeepersBrotherWorksGameCorner::
    .string "Le frère du marchand a pris un\n"
    .string "boulot à la SALLE DE JEUX.\p"
    .string "Il essaie de réunir de l'argent\n"
    .string "pour acheter plus de marchandise.$"

TwoIsland_Text_BrunoCameToIslandWhileBack::
    .string "Écoute, écoute.\n"
    .string "Tu savais?\p"
    .string "Un DRESSEUR célèbre est venu sur\n"
    .string "l'ÎLE il y a peu.\p"
    .string "Il fait partie du CONSEIL 4.\n"
    .string "Il s'appelle ALDO.\p"
    .string "Il est reparti déçu en apprenant\n"
    .string "qu'il n'y avait plus de\l"
    .string "Bonbons Rage.$"

TwoIsland_Text_BuyRareItemsHere::
    .string "Le DRESSEUR avisé sait qu'on\n"
    .string "achète des objets rares ici!$"

TwoIsland_Text_OldWomanLivesOutOnCape::
    .string "Une vieille dame vit dans une\n"
    .string "maisonnette sur le cap.\p"
    .string "Elle dévisage les POKéMON.\n"
    .string "C'est un peu troublant.$"

TwoIsland_Text_HaveYouTriedJumpingGame::
    .string "Boing! Boing!\n"
    .string "Tu as essayé le jeu de sauts?\p"
    .string "Les POKéMON qu'on peut inscrire…\n"
    .string "Boing!\p"
    .string "Certains font boing!\p"
    .string "Et d'autres font boooooooing!\p"
    .string "Tu le savais?\n"
    .string "Boing!$"

