Route12_FishingHouse_Text_DoYouLikeToFish::
    .string "Je suis le frère cadet du MAÎTRE\n"
    .string "PÊCHEUR.\p"
    .string "J'adooore la pêche!\n"
    .string "Je ne peux pas m'en passer.\p"
    .string "Dis-moi, tu aimes pêcher?$"

Route12_FishingHouse_Text_TakeThisAndFish::
    .string "Formidable! Tu me plais.\n"
    .string "On va être amis, je crois.\p"
    .string "Prends ceci et va pêcher, mon ami!$"

Route12_FishingHouse_Text_ReceivedSuperRod::
    .string "{PLAYER} reçoit une MÉGA CANNE du\n"
    .string "frère du MAÎTRE PÊCHEUR.$"

Route12_FishingHouse_Text_IfYouCatchBigMagikarpShowMe::
    .string "La pêche, c'est un art de vivre!\n"
    .string "C'est comme la plus belle poésie.\p"
    .string "Des mers aux rivières, va pêcher\n"
    .string "le plus gros, mon ami.\p"
    .string "Maintenant, j'ai une requête.\p"
    .string "Si tu attrapes un gros MAGICARPE \n"
    .string "avec cette CANNE, montre-le-moi.\p"
    .string "J'adore pêcher, mais j'adore aussi\n"
    .string "voir des MAGICARPE géants.$"

Route12_FishingHouse_Text_OhThatsDisappointing::
    .string "Oh…\n"
    .string "Quelle déception…$"

Route12_FishingHouse_Text_TryFishingBringMeMagikarp::
    .string "Bonjour, {PLAYER}!\n"
    .string "Tu as pêché?\p"
    .string "Essaie la MÉGA CANNE dans\n"
    .string "n'importe quelle étendue d'eau.\p"
    .string "On trouve des POKéMON différents\n"
    .string "selon les endroits.\p"
    .string "Et n'oublie pas de m'apporter des\n"
    .string "MAGICARPE géants.$"

Route12_FishingHouse_Text_OhMagikarpAllowMeToSee::
    .string "Oh? {PLAYER}?\n"
    .string "Mais c'est un MAGICARPE!\p"
    .string "Fais-le-moi voir, vite!$"

Route12_FishingHouse_Text_WhoaXInchesTakeThis::
    .string "… … …Ouah!\n"
    .string "{STR_VAR_2} pouces!\p"
    .string "Tu as un sens rare de la poésie\n"
    .string "de la pêche!\p"
    .string "Tu dois prendre ceci.\n"
    .string "J'insiste!$"

Route12_FishingHouse_Text_LookForwardToGreaterRecords::
    .string "J'ai hâte de voir tes prochains\n"
    .string "records!$"

Route12_FishingHouse_Text_HuhXInchesSameSizeAsLast::
    .string "Hein?\n"
    .string "{STR_VAR_2} pouces?\p"
    .string "C'est la même taille que celui\n"
    .string "que j'ai vu avant.$"

Route12_FishingHouse_Text_HmmXInchesDoesntMeasureUp::
    .string "Hmm…\n"
    .string "Celui-ci fait {STR_VAR_2} pouces.\p"
    .string "Il ne vaut pas celui de\n"
    .string "{STR_VAR_3} pouces d'avant.$"

Route12_FishingHouse_Text_DoesntLookLikeMagikarp::
    .string "Euh… Ça ne ressemble pas beaucoup\n"
    .string "à un MAGICARPE.$"

Route12_FishingHouse_Text_NoRoomForGift::
    .string "Oh, non!\p"
    .string "J'avais un cadeau pour toi, mais tu\n"
    .string "n'as pas de place.$"

Route12_FishingHouse_Text_MostGiganticMagikarpXInches::
    .string "Le plus gigantesque MAGICARPE\n"
    .string "que j'aie jamais vu…\p"
    .string "{STR_VAR_3} pouces!$"

Route12_FishingHouse_Text_BlankChartOfSomeSort::
    .string "C'est une sorte de tableau vide.\p"
    .string "Il y a des cases pour noter des\n"
    .string "records.$"

