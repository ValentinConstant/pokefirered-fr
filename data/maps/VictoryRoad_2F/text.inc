VictoryRoad_2F_Text_DawsonIntro::
    .string "Si tu passes ici, tu pourras\n"
    .string "affronter le CONSEIL 4.$"

VictoryRoad_2F_Text_DawsonDefeat::
    .string "Non!\n"
    .string "Incroyable!$"

VictoryRoad_2F_Text_DawsonPostBattle::
    .string "Je te bats quand il s'agit de\n"
    .string "connaissances sur les POKéMON!$"

VictoryRoad_2F_Text_DaisukeIntro::
    .string "Ici, c'est la ROUTE VICTOIRE.\n"
    .string "L'épreuve finale des DRESSEURS!$"

VictoryRoad_2F_Text_DaisukeDefeat::
    .string "Atcho!$"

VictoryRoad_2F_Text_DaisukePostBattle::
    .string "Si tu es bloqué, essaie de\n"
    .string "déplacer des rochers.$"

VictoryRoad_2F_Text_NelsonIntro::
    .string "Ah, tu veux donc défier le\n"
    .string "CONSEIL 4?$"

VictoryRoad_2F_Text_NelsonDefeat::
    .string "Tu m'as eu!$"

VictoryRoad_2F_Text_NelsonPostBattle::
    .string "{RIVAL} est aussi passé par ici.$"

VictoryRoad_2F_Text_VincentIntro::
    .string "Allez!\n"
    .string "Je vais t'écraser!$"

VictoryRoad_2F_Text_VincentDefeat::
    .string "Je me suis fait battre!$"

VictoryRoad_2F_Text_VincentPostBattle::
    .string "Tu as gagné le droit d'être sur la\n"
    .string "ROUTE VICTOIRE…$"

VictoryRoad_2F_Text_GregoryIntro::
    .string "La ROUTE VICTOIRE est trop dure?$"

VictoryRoad_2F_Text_GregoryDefeat::
    .string "Bien joué!$"

VictoryRoad_2F_Text_GregoryPostBattle::
    .string "Beaucoup de DRESSEURS abandonnent\n"
    .string "ici et rentrent chez eux.$"

