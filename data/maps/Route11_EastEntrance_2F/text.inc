Route11_EastEntrance_2F_Text_GiveItemfinderIfCaught30::
    .string "Salut! Tu te souviens de moi?\n"
    .string "Je suis un ASSISTANT du PR CHEN.\p"
    .string "Si ton POKéDEX a les données de\n"
    .string "{STR_VAR_1} espèces, je dois te\l"
    .string "remettre une récompense.\p"
    .string "Le PR CHEN m'a confié\n"
    .string "{STR_VAR_2} pour toi.\p"
    .string "Alors, {PLAYER}, dis-moi.\p"
    .string "As-tu les données d'au moins\n"
    .string "{STR_VAR_1} espèces de POKéMON?$"

Route11_EastEntrance_2F_Text_GreatHereYouGo::
    .string "Génial! Tu as attrapé ou possédé\n"
    .string "{STR_VAR_3} espèces de POKéMON!\p"
    .string "Félicitations!\n"
    .string "Voilà pour toi!$"

Route11_EastEntrance_2F_Text_ReceivedItemfinderFromAide::
    .string "{PLAYER} reçoit {STR_VAR_2}\n"
    .string "de l'ASSISTANT.$"

Route11_EastEntrance_2F_Text_ExplainItemfinder::
    .string "Des objets au sol peuvent être\n"
    .string "cachés à la vue.\p"
    .string "Utilise le CHERCH'OBJET pour\n"
    .string "détecter les objets cachés proches.\p"
    .string "La machine est un peu limitée.\n"
    .string "Elle ne localise pas l'objet.\p"
    .string "Elle indique la direction où se\n"
    .string "trouve l'objet.\p"
    .string "Oriente-toi avec, puis fouille\n"
    .string "la zone suspecte à la main.$"

Route11_EastEntrance_2F_Text_BigMonAsleepOnRoad::
    .string "Voyons ce que montrent les\n"
