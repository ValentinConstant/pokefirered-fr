Route13_Text_SebastianIntro::
    .string "Mes POKéMON oiseaux veulent te\n"
    .string "combattre!$"

Route13_Text_SebastianDefeat::
    .string "Mon duo ROUCOOL et ROUCOOPS\n"
    .string "a perdu?$"

Route13_Text_SebastianPostBattle::
    .string "Mes POKéMON ont l'air contents même\n"
    .string "s'ils ont perdu.$"

Route13_Text_SusieIntro::
    .string "On dit que je suis douée pour mon\n"
    .string "âge.$"

Route13_Text_SusieDefeat::
    .string "Ohh!\n"
    .string "J'ai perdu!$"

Route13_Text_SusiePostBattle::
    .string "Je veux devenir une bonne\n"
    .string "DRESSEUSE. Je vais bosser dur!$"

Route13_Text_ValerieIntro::
    .string "Ouah!\n"
    .string "Tes BADGES sont trop cool!$"

Route13_Text_ValerieDefeat::
    .string "Pas assez!$"

Route13_Text_ValeriePostBattle::
    .string "Tu as eu ces BADGES grâce aux\n"
    .string "CHAMPIONS d'ARÈNE. Je le sais!$"

Route13_Text_GwenIntro::
    .string "Mes adorables POKéMON veulent\n"
    .string "faire ta connaissance.$"

Route13_Text_GwenDefeat::
    .string "Bien joué!\n"
    .string "Tu as gagné haut la main!$"

Route13_Text_GwenPostBattle::
    .string "Il faut faire combattre les POKéMON\n"
    .string "pour les endurcir.$"

Route13_Text_AlmaIntro::
    .string "J'ai trouvé du CARBONE dans une\n"
    .string "grotte en faisant de la spéléo.$"

Route13_Text_AlmaDefeat::
    .string "Oh, dommage!\n"
    .string "J'ai raté mon coup!$"

Route13_Text_AlmaPostBattle::
    .string "Le CARBONE a augmenté la VITESSE\n"
    .string "de mes POKéMON.$"

Route13_Text_PerryIntro::
    .string "Je ne vais pas perdre.\n"
    .string "Pas avec le vent dans mon dos!$"

Route13_Text_PerryDefeat::
    .string "Le vent a tourné!$"

Route13_Text_PerryPostBattle::
    .string "Je suis battu.\n"
    .string "Je vais rentrer en VOL.$"

Route13_Text_LolaIntro::
    .string "Bien sûr, je vais jouer avec toi,\n"
    .string "mon chou.$"

Route13_Text_LolaDefeat::
    .string "Oh!\n"
    .string "Petite brute!$"

Route13_Text_LolaPostBattle::
    .string "Qui est le plus fort, je me\n"
    .string "demande, les mâles ou les femelles?$"

Route13_Text_SheilaIntro::
    .string "Tu veux faire un combat de\n"
    .string "POKéMON avec moi?$"

Route13_Text_SheilaDefeat::
    .string "C'est déjà fini?$"

Route13_Text_SheilaPostBattle::
    .string "En fait, je ne connais rien aux\n"
    .string "POKéMON.\p"
    .string "Ceux que j'utilise… Je les ai\n"
    .string "choisis pour leur look!$"

Route13_Text_JaredIntro::
    .string "Qu'est-ce que tu regardes?$"

Route13_Text_JaredDefeat::
    .string "Zut!\n"
    .string "J'ai cassé ma chaîne!$"

Route13_Text_JaredPostBattle::
    .string "Dégage!$"

Route13_Text_RobertIntro::
    .string "Je choisis toujours des POKéMON\n"
    .string "oiseaux. Je leur suis dévoué.$"

Route13_Text_RobertDefeat::
    .string "Plus d'énergie!$"

Route13_Text_RobertPostBattle::
    .string "J'aimerais voler comme ROUCOOL et\n"
    .string "ROUCOOPS…$"

Route13_Text_LookToLeftOfThatPost::
    .string "CONSEILS AUX DRESSEURS\p"
    .string "Regarde, regarde!\n"
    .string "Regarde à gauche de ce poteau!$"

Route13_Text_SelectToSwitchItems::
    .string "CONSEILS AUX DRESSEURS\p"
    .string "Utilise SELECT pour déplacer les\n"
    .string "objets dans la fenêtre OBJETS.$"

Route13_Text_RouteSign::
    .string "ROUTE 13\n"
    .string "Nord: PONT DU SILENCE$"

