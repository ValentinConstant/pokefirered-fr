Route2_EastBuilding_Text_GiveHM05IfSeen10Mons::
    .string "Salut! Tu te souviens de moi?\n"
    .string "Je suis un ASSISTANT du PR CHEN.\p"
    .string "Si ton POKéDEX a les données de\n"
    .string "dix espèces, je dois te remettre\l"
    .string "une récompense.\p"
    .string "Le PR CHEN m'a confié la\n"
    .string "CS05 pour toi.\p"
    .string "Alors, {PLAYER}, dis-moi.\p"
    .string "As-tu les données d'au moins\n"
    .string "dix espèces de POKéMON?$"

Route2_EastBuilding_Text_GreatHereYouGo::
    .string "Génial! Tu as attrapé ou possédé\n"
    .string "{STR_VAR_3} espèces de POKéMON!\p"
    .string "Félicitations!\n"
    .string "Voilà pour toi!$"

Route2_EastBuilding_Text_ReceivedHM05FromAide::
    .string "{PLAYER} reçoit la CS05\n"
    .string "de l'ASSISTANT.$"

Route2_EastBuilding_Text_ExplainHM05::
    .string "La CS05 contient la capacité\n"
    .string "FLASH.\p"
    .string "FLASH éclaire même les grottes et\n"
    .string "les souterrains les plus sombres.$"

Route2_EastBuilding_Text_CanGetThroughRockTunnel::
    .string "Quand un POKéMON connaît FLASH, tu\n"
    .string "peux traverser la GROTTE.$"

