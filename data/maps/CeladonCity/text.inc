CeladonCity_Text_GotMyKoffingInCinnabar::
    .string "J'ai eu mon SMOGO À CRAMOIS'ÎLE.\p"
    .string "Il est gentil, mais il crache du\n"
    .string "poison quand il est en colère.$"

CeladonCity_Text_GymIsGreatFullOfWomen::
    .string "Héhé! Cette ARÈNE est géniale!\n"
    .string "C'est plein de filles!$"

CeladonCity_Text_GameCornerIsBadForCitysImage::
    .string "CÉLADOPOLE est fière de ses\n"
    .string "efforts pour rester belle.\p"
    .string "C'est pourquoi le nouveau CASINO\n"
    .string "nuit à l'image de la ville.$"

CeladonCity_Text_BlewItAllAtSlots::
    .string "Pfff…\n"
    .string "J'ai tout perdu aux machines!\p"
    .string "J'aurais dû échanger mes JETONS\n"
    .string "contre des lots!$"

CeladonCity_Text_MyTrustedPalPoliwrath::
    .string "Voici mon fidèle ami, TARTARD.\p"
    .string "Il a évolué de TÊTARTE quand\n"
    .string "j'ai utilisé une PIERRE EAU.$"

CeladonCity_Text_Poliwrath::
    .string "TARTARD: Ribi ribit!$"

CeladonCity_Text_GetLostOrIllPunchYou::
    .string "Qu'est-ce que tu regardes?\n"
    .string "Dégage, ou je te cogne.$"

CeladonCity_Text_KeepOutOfTeamRocketsWay::
    .string "Ne te mets pas en travers de\n"
    .string "la TEAM ROCKET!$"

CeladonCity_Text_ExplainXAccuracyDireHit::
    .string "CONSEILS AUX DRESSEURS\p"
    .string "PRÉCISION + augmente la précision\n"
    .string "des capacités.\p"
    .string "MUSCLE+ augmente les chances\n"
    .string "de coups critiques.\p"
    .string "Achète tes objets au CENTRE\n"
    .string "COMMERCIAL de CÉLADOPOLE!$"

CeladonCity_Text_CitySign::
    .string "CÉLADOPOLE\n"
    .string "La ville aux rêves arc-en-ciel$"

CeladonCity_Text_GymSign::
    .string "ARÈNE POKéMON de CÉLADOPOLE\n"
    .string "CHAMPIONNE: ERIKA La princesse\l"
    .string "amoureuse de la nature!$"

CeladonCity_Text_MansionSign::
    .string "CELADON MANSION$"

CeladonCity_Text_DeptStoreSign::
    .string "Trouvez tout ce qu'il vous faut au\n"
    .string "CENTRE COMMERCIAL de CÉLADOPOLE!$"

CeladonCity_Text_GuardSpecProtectsFromStatus::
    .string "CONSEILS AUX DRESSEURS\p"
    .string "PROTECTION protège les POKéMON\n"
    .string "des capacités qui baissent leurs\l"
    .string "stats en combat.\p"
    .string "Achète tes objets au CENTRE\n"
    .string "COMMERCIAL de CÉLADOPOLE!$"

CeladonCity_Text_PrizeExchangeSign::
    .string "JETONS échangés contre des lots!\n"
    .string "COMPTOIR DES LOTS$"

CeladonCity_Text_GameCornerSign::
    .string "CASINO ROCKET\n"
    .string "Le terrain de jeu des grands!$"

CeladonCity_Text_ScaldedTongueOnTea::
    .string "Aaaah, aïe…\n"
    .string "Je me suis brûlé la langue!\p"
    .string "Une vieille dame du MANOIR m'a\n"
    .string "offert du THÉ.\p"
    .string "Mais il était bouillant!\n"
    .string "Il faut le laisser refroidir.$"

Text_SoftboiledTeach::
    .string "Bonjour!\p"
    .string "Je t'ai déjà vu passer, mais on\n"
    .string "n'a jamais pu discuter.\p"
    .string "C'est la chance qui nous a enfin\n"
    .string "réunis.\p"
    .string "Pour fêter ça, je vais t'apprendre\n"
    .string "la capacité E-COQUE.$"

Text_SoftboiledDeclined::
    .string "Je garderai toujours un oeil\n"
    .string "sur toi.\p"
    .string "J'espère qu'on reparlera bientôt.$"

Text_SoftboiledWhichMon::
    .string "Alors, quel POKéMON aura la chance\n"
    .string "d'apprendre E-COQUE?$"

Text_SoftboiledTaught::
    .string "Je te souhaite bonne chance!$"

CeladonCity_Text_SomeoneStoleSilphScope::
    .string "Oh, que vais-je faire…\p"
    .string "Quelqu'un a volé notre SCOPE\n"
    .string "SYLPHE.\p"
    .string "Le voleur a couru par ici,\n"
    .string "j'en suis sûr.\p"
    .string "Mais je l'ai perdu de vue!\n"
    .string "Où est-il passé?$"

