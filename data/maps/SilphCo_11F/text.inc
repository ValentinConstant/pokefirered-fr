SilphCo_11F_Text_ObtainedMasterBallFromPresident::
    .string "{PLAYER} obtient une MASTER BALL\n"
    .string "du PRÉSIDENT!$"

SilphCo_11F_Text_ThatsOurSecretPrototype::
    .string "PRÉSIDENT: Tu ne la trouveras\n"
    .string "nulle part ailleurs.\p"
    .string "C'est notre prototype secret de\n"
    .string "MASTER BALL.\p"
    .string "Elle attrape n'importe quel POKéMON\n"
    .string "à coup sûr!\p"
    .string "Mais sois discret quand tu\n"
    .string "l'utilises.$"

SilphCo_11F_Text_YouHaveNoRoomForThis::
    .string "Tu n'as pas de place pour ça.$"

SilphCo_11F_Text_ThanksForRescuingUs::
    .string "SECRÉTAIRE: Merci de nous avoir\n"
    .string "tous sauvés.\p"
    .string "Du PRÉSIDENT au dernier employé,\n"
    .string "nous te sommes redevables.$"

SilphCo_11F_Text_GiovanniIntro::
    .string "Ah, {PLAYER}!\n"
    .string "Nous nous retrouvons!\p"
    .string "Le PRÉSIDENT et moi discutons\n"
    .string "d'une affaire vitale.\p"
    .string "Ne te mêle pas des affaires des\n"
    .string "grands…\p"
    .string "Ou tu vas souffrir mille morts!$"

SilphCo_11F_Text_GiovanniDefeat::
    .string "Arrgh!!\n"
    .string "Encore perdu!?$"

SilphCo_11F_Text_GiovanniPostBattle::
    .string "Bon sang!\n"
    .string "Tu as gâché nos plans pour SYLPHE!\p"
    .string "Mais la TEAM ROCKET ne tombera\n"
    .string "jamais!\p"
    .string "{PLAYER}! N'oublie jamais que tous\n"
    .string "les POKéMON existent pour la TEAM\l"
    .string "ROCKET!\p"
    .string "Je dois partir, mais je reviendrai!$"

