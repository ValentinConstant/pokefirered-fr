Route10_PokemonCenter_1F_Text_EveryTypeStrongerThanOthers::
    .string "Les types de POKéMON n'ont pas\n"
    .string "tous les mêmes affinités.\p"
    .string "Chaque type est fort contre\n"
    .string "certains et faible contre d'autres.$"

Route10_PokemonCenter_1F_Text_NuggetUselessSoldFor5000::
    .string "Une PÉPITE ne sert à rien.\n"
    .string "Alors je l'ai vendue ¥5000.$"

Route10_PokemonCenter_1F_Text_HeardGhostsHauntLavender::
    .string "Il paraît que des fantômes hantent\n"
    .string "LAVANVILLE.$"

Route10_PokemonCenter_1F_Text_GiveEverstoneIfCaught20Mons::
    .string "Oh… {PLAYER}!\n"
    .string "Je te cherchais!\p"
    .string "C'est moi, un des ASSISTANTS\n"
    .string "omniprésents du PR CHEN.\p"
    .string "Si ton POKéDEX a les données de\n"
    .string "vingt espèces, je dois te remettre\l"
    .string "une récompense du PR CHEN.\p"
    .string "Il m'a confié cette PIERRE\n"
    .string "STASE.\p"
    .string "Alors, {PLAYER}, dis-moi.\p"
    .string "As-tu les données d'au moins\n"
    .string "vingt espèces de POKéMON?$"

Route10_PokemonCenter_1F_Text_GreatHereYouGo::
    .string "Génial! Tu as attrapé ou possédé\n"
    .string "{STR_VAR_3} espèces de POKéMON!\p"
    .string "Félicitations!\n"
    .string "Voilà pour toi!$"

Route10_PokemonCenter_1F_Text_ReceivedEverstoneFromAide::
    .string "{PLAYER} reçoit la PIERRE STASE\n"
    .string "de l'ASSISTANT.$"

Route10_PokemonCenter_1F_Text_ExplainEverstone::
    .string "Faire évoluer des POKéMON enrichit\n"
    .string "bien sûr le POKéDEX.\p"
    .string "Mais parfois, tu ne voudras pas\n"
    .string "qu'un POKéMON évolue.\p"
    .string "Dans ce cas, donne la PIERRE STASE\n"
    .string "à ce POKéMON.\p"
    .string "Elle empêche l'évolution, d'après\n"
    .string "le PROFESSEUR.$"

